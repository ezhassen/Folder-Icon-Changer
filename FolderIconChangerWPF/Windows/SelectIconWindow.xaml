<mm:MetroWindow
    x:Class="FolderIconChangerWPF.Windows.SelectIconWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ap="clr-namespace:FolderIconChangerWPF.AttachedProperties"
    xmlns:conv="clr-namespace:FolderIconChangerWPF.ValueConverters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
    xmlns:lex="http://wpflocalizeextension.codeplex.com"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:mm="http://metro.mahapps.com/winfx/xaml/controls"
    xmlns:serv="clr-namespace:FolderIconChangerWPF.Services"
    xmlns:vm="clr-namespace:FolderIconChangerWPF.ViewModels"
    Title="{lex:BLoc Select_Icon_Title, TargetNullValue=Select Icon}"
    Width="570"
    MinWidth="300"
    MinHeight="300"
    ap:ControlOnLoad.Command="{Binding LoadIconsCommand}"
    ap:WindowHelper.CloseOnESCKey="True"
    lex:LocalizeDictionary.DesignCulture="en"
    lex:LocalizeDictionary.OutputMissingKeys="True"
    lex:ResxLocalizationProvider.DefaultAssembly="Folder Icon Changer"
    lex:ResxLocalizationProvider.DefaultDictionary="Resources"
    Icon="pack://application:,,,/Icon.ico"
    IconOverlayBehavior="Always"
    ShowIconOnTitleBar="False"
    ShowInTaskbar="False"
    ShowMinButton="False"
    TitleAlignment="Stretch"
    WindowButtonCommandsOverlayBehavior="Always"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">
    <!--  DataContext="{Binding Source={x:Static vm:ApplicationViewModel.Instance}}"  -->
    <mm:MetroWindow.DataContext>
        <vm:SelectIconViewModel x:Name="ViewModel" />
    </mm:MetroWindow.DataContext>

    <mm:MetroWindow.Resources>

        <DataTemplate x:Key="ImageInfoTemplate">
            <Border
                x:Name="PART_ItemBorder"
                Width="{Binding CurrentImageViewSize.Width, ElementName=ViewModel}"
                Height="{Binding CurrentImageViewSize.Height, ElementName=ViewModel}"
                Margin="5">
                <!--<Border.ToolTip>
                    <MultiBinding Converter="{conv:StringFormatConverter}" ConverterParameter="{}{0}x{1}, {2}, {3}">
                        <Binding Path="Size.Width" />
                        <Binding Path="Size.Height" />
                        <Binding Converter="{conv:LexEnumConverter}" Path="ColorsType" />
                        <Binding Converter="{conv:LexEnumConverter}" Path="IconImageFormat" />
                    </MultiBinding>
                </Border.ToolTip>-->
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">

                        <Image
                            x:Name="PART_Image"
                            ap:IconInfoHelper.IconInfo="{Binding}"
                            ap:IconInfoHelper.IconSizeW="{Binding CurrentImageViewSize.Width, ElementName=ViewModel}"
                            Source="{Binding (ap:IconInfoHelper.ImageSource), RelativeSource={RelativeSource Self}}"
                            StretchDirection="DownOnly" />

                        <Grid Visibility="{Binding (ap:IconInfoHelper.IsLoading), ElementName=PART_Image, Converter={conv:VisibilityWhenTrueConverter}}">
                            <Viewbox
                                Margin="5"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource SpinningText}" />
                            </Viewbox>
                            <Border
                                Grid.Row="1"
                                IsHitTestVisible="False"
                                Opacity="0.3">
                                <Border ap:AnimateFadeInProperty.Value="True" Background="{DynamicResource WhiteBrush}" />
                            </Border>
                        </Grid>
                    </Grid>

                    <!--  return string.Format("{0}, {1}, {2}", iii.Size.ToString_1(), iii.ColorsType.ToString(), iii.IconImageFormat.ToString());  -->
                    <TextBlock
                        Grid.Row="1"
                        HorizontalAlignment="Center"
                        FlowDirection="LeftToRight"
                        Text="{Binding Index}">
                        <!--  FlowDirection="{lex:BLoc FlowDirection, TargetNullValue=LeftToRight}"  -->
                        <!--  Size  -->
                        <!--<Run>
                            <Run.Text>
                                <MultiBinding Converter="{conv:StringFormatConverter}" ConverterParameter="{}{0}x{1}">
                                    <Binding Path="Size.Width" />
                                    <Binding Path="Size.Height" />
                                </MultiBinding>
                            </Run.Text>
                        </Run>-->

                        <!--  ColorsType  -->
                        <!--<Run Text=", " /><lex:EnumRun
                            EnumValue="{Binding ColorsType}"
                            PrependType="True"
                            Separator="_" />-->
                        <!--  IconImageFormat  -->
                        <!--<Run Text=", " /><lex:EnumRun
                            EnumValue="{Binding IconImageFormat}"
                            PrependType="True"
                            Separator="_" />-->
                    </TextBlock>
                </Grid>
            </Border>
        </DataTemplate>

    </mm:MetroWindow.Resources>

    <Grid ap:ListViewHelper.DeselectOnMouseDown="{Binding ElementName=LV}" ap:WindowHelper.MoveWindowOnMouseDown="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=Window}}">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ToolBar Grid.Row="0" MinHeight="50">
            <Button Width="50" Command="{Binding BrowseForFileCommand}">
                <Viewbox Margin="5">
                    <!--<iconPacks:PackIconFontAwesome Kind="FolderOpenSolid" />-->
                    <iconPacks:PackIconFontAwesome Kind="FileSolid" />
                </Viewbox>
            </Button>
            <Separator Margin="5,8" />
            <Button Width="50">
                <Viewbox Margin="5">
                    <iconPacks:PackIconFontAwesome Kind="ThSolid" />
                    <!--<iconPacks:PackIconFontAwesome Kind="ThListSolid" />-->
                    <!--<iconPacks:PackIconFontAwesome Kind="ThLargeSolid" />-->
                </Viewbox>
            </Button>

        </ToolBar>

        <ComboBox
            Grid.Row="1"
            Margin="5"
            ap:TextBoxHelper.ClearFilterCommand="{Binding ClearCommand}"
            ap:TextBoxHelper.EditType="Path"
            ap:TextBoxHelper.FilterByEnterKey="True"
            ap:TextBoxHelper.FilterCommand="{Binding LoadIconsCommand}"
            ap:TextBoxHelper.IsFiltering="{Binding IsLoadingIcons}"
            ap:TextBoxHelper.RequireFilterAction="{Binding RequireRefresh}"
            ap:TextBoxHelper.RequireFilterButtonToolTip="{lex:BLoc GetIcon, TargetNullValue=Get Icon}"
            mm:TextBoxHelper.UseFloatingWatermark="True"
            mm:TextBoxHelper.Watermark="{lex:BLoc FilePath, TargetNullValue=File Path}"
            IsReadOnly="{Binding IsWorking}"
            ItemsSource="{Binding RecentFilesWithDefaults, Source={x:Static serv:SettingsService.Instance}}"
            Style="{StaticResource PathComboBox2}"
            Text="{Binding FilePath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

        <ListView
            x:Name="LV"
            Grid.Row="2" SelectedItem="{Binding SelectedIconInfo}"
            ap:ControlHelper.MouseWheelCommand="{Binding ChangeImageViewSizeCommand}"
            ap:ControlHelper.MouseWheelCommandOnControlKey="True"
            ItemTemplate="{StaticResource ImageInfoTemplate}"
            ItemsSource="{Binding Icons}"
            SelectionMode="Single">
            <ListView.ItemsPanel>
                <ItemsPanelTemplate>
                    <!--<WrapPanel />-->
                    <!--<UniformGrid Columns="3"  />-->
                    <WrapPanel
                        Width="{Binding (FrameworkElement.ActualWidth), RelativeSource={RelativeSource AncestorType=ScrollContentPresenter}}"
                        MinWidth="{Binding (ListView.View).ItemWidth, RelativeSource={RelativeSource AncestorType=ListView}}"
                        ItemHeight="{Binding (ListView.View).ItemHeight, RelativeSource={RelativeSource AncestorType=ListView}}"
                        ItemWidth="{Binding (ListView.View).ItemWidth, RelativeSource={RelativeSource AncestorType=ListView}}" />
                </ItemsPanelTemplate>
            </ListView.ItemsPanel>

        </ListView>

        <!--  Buttons  -->
        <Grid Grid.Row="3" HorizontalAlignment="Right">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            
            <Button
                Grid.Column="0"
                Margin="5"
                HorizontalAlignment="Right"
                mm:ControlsHelper.ContentCharacterCasing="Upper"
                Content="Cancel"
                FontSize="{DynamicResource FontSizeLarge}"
                IsCancel="True" />

            <Button Command="{Binding OKCommand}"
                Grid.Column="1"
                Margin="5"
                HorizontalAlignment="Right"
                mm:ControlsHelper.ContentCharacterCasing="Upper"
                Content="Select"
                FontSize="{DynamicResource FontSizeLarge}"
                IsDefault="True"
                IsEnabled="{Binding IsWorking, Converter={conv:BooleanInvertConverter}}" />

        </Grid>

        <StatusBar
            Grid.Row="10"
            Background="{DynamicResource AccentColorBrush2}"
            FlowDirection="{lex:BLoc FlowDirection, TargetNullValue=LeftToRight}">
            <StatusBar.Effect>
                <DropShadowEffect
                    BlurRadius="15"
                    ShadowDepth="1"
                    Color="{DynamicResource AccentBaseColor}" />
            </StatusBar.Effect>
            <StatusBar.Resources>
                <Style x:Key="SeparatorStyle" TargetType="Separator">
                    <!--<Setter Property="Foreground" Value="{DynamicResource WordRedBrush}" />-->
                    <Setter Property="Background" Value="{DynamicResource GrayBrush5}" />
                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect
                                BlurRadius="8"
                                Direction="270"
                                ShadowDepth="1"
                                Color="{DynamicResource BlackColor}" />
                        </Setter.Value>
                    </Setter>
                    <Setter Property="Margin" Value="5,3" />
                </Style>
            </StatusBar.Resources>

            <!--  All Count  -->
            <Run Text="{lex:BLoc Select_Icon_Count, TargetNullValue=Count}" />
            <Run Text=":" />
            <Run Text="{Binding Items.Count, ElementName=LV, Mode=OneWay}" />

            <Separator Style="{StaticResource SeparatorStyle}" />

            <!--  Selected Count  -->
            <Run Text="{lex:BLoc Select_Icon_Index, TargetNullValue=Index}" />
            <Run Text=":" />
            <Run Text="{Binding SelectedItem.Index, ElementName=LV, Mode=OneWay}" />

        </StatusBar>
    </Grid>
</mm:MetroWindow>
