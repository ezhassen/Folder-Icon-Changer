<mm:MetroWindow
    x:Class="FolderIconChangerWPF.Windows.SelectIconWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ap="clr-namespace:FolderIconChangerWPF.AttachedProperties"
    xmlns:conv="clr-namespace:FolderIconChangerWPF.ValueConverters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:lex="http://wpflocalizeextension.codeplex.com"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:mm="http://metro.mahapps.com/winfx/xaml/controls"
    xmlns:serv="clr-namespace:FolderIconChangerWPF.Services"
    xmlns:vm="clr-namespace:FolderIconChangerWPF.ViewModels"
    Title="{lex:BLoc Select_Icon_Title, TargetNullValue=Select Icon}"
    Width="570"
    MinWidth="300"
    MinHeight="300"
    ap:ControlHelper.OnLoadCommand="{Binding LoadIconsCommand}"
    ap:WindowHelper.CloseOnESCKey="True"
    ap:WindowHelper.MoveWindowOnMouseDown="{Binding RelativeSource={RelativeSource Mode=Self}}"
    lex:LocalizeDictionary.DesignCulture="en"
    lex:LocalizeDictionary.OutputMissingKeys="True"
    lex:ResxLocalizationProvider.DefaultAssembly="Folder Icon Changer"
    lex:ResxLocalizationProvider.DefaultDictionary="Resources"
    Icon="pack://application:,,,/Icon.ico"
    IconOverlayBehavior="Always"
    ShowIconOnTitleBar="False"
    ShowInTaskbar="False"
    ShowMinButton="False"
    TitleAlignment="Stretch"
    WindowButtonCommandsOverlayBehavior="Always"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d" ap:WindowHelper.OnClosingCommand="{Binding OnClosingCommand}">
    <!--  DataContext="{Binding Source={x:Static vm:ApplicationViewModel.Instance}}"  -->
    <mm:MetroWindow.DataContext>
        <vm:SelectIconViewModel x:Name="ViewModel" />
    </mm:MetroWindow.DataContext>

    <mm:MetroWindow.Resources>

        <Style
            x:Key="ViewSizeItem"
            BasedOn="{StaticResource MahApps.Styles.MenuItem}"
            TargetType="MenuItem">
            <Setter Property="Command" Value="{Binding ChangeImageViewSizeCommand}" />
            <Setter Property="CommandParameter" Value="{Binding Tag, RelativeSource={RelativeSource Self}}" />
            <!--<Setter Property="IsChecked" Value="{Binding CurrentImageViewSizeW}" />-->
            <!--<Setter Property="Header">
                <Setter.Value>
                    <MultiBinding Converter="{conv:StringFormatConverter}" ConverterParameter="{}{0}x{1}">
                        <Binding Path="Tag" Source="{RelativeSource Mode=FindAncestor, AncestorType=MenuItem}" />
                        <Binding Path="Tag" Source="{RelativeSource Mode=FindAncestor, AncestorType=MenuItem}" />
                    </MultiBinding>
                </Setter.Value>
            </Setter>-->
        </Style>

        <DataTemplate x:Key="ImageInfoTemplate">
            <Border Background="Transparent"
                x:Name="PART_ItemBorder"
                Margin="5" IsHitTestVisible="True" Focusable="True"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
                <Border.InputBindings>
                    <KeyBinding Key="Return" Command="{Binding OKCommand, ElementName=ViewModel}" />
                    <MouseBinding Command="{Binding OKCommand, ElementName=ViewModel}" MouseAction="LeftDoubleClick" />
                </Border.InputBindings>

                <!--<Border.ToolTip>
                    <MultiBinding Converter="{conv:StringFormatConverter}" ConverterParameter="{}{0}x{1}, {2}, {3}">
                        <Binding Path="Size.Width" />
                        <Binding Path="Size.Height" />
                        <Binding Converter="{conv:LexEnumConverter}" Path="ColorsType" />
                        <Binding Converter="{conv:LexEnumConverter}" Path="IconImageFormat" />
                    </MultiBinding>
                </Border.ToolTip>-->
                <Grid Focusable="True" IsHitTestVisible="True">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid
                        Grid.Row="0"
                        Width="{Binding CurrentImageViewSizeW, ElementName=ViewModel}"
                        Height="{Binding CurrentImageViewSizeW, ElementName=ViewModel}">

                        <Image
                            x:Name="PART_Image"
                            ap:IconInfoHelper.IconInfo="{Binding}"
                            ap:IconInfoHelper.IconSizeW="{Binding CurrentImageViewSizeW, ElementName=ViewModel}"
                            Source="{Binding (ap:IconInfoHelper.ImageSource), RelativeSource={RelativeSource Self}}"
                            Stretch="{Binding ImageStretch, ElementName=ViewModel}"
                            StretchDirection="{Binding ImageStretchDirection, ElementName=ViewModel}" />

                        <Grid Visibility="{Binding (ap:IconInfoHelper.IsLoading), ElementName=PART_Image, Converter={conv:VisibilityWhenTrueConverter}}">
                            <Viewbox
                                Margin="5"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource SpinningText}" />
                            </Viewbox>
                            <Border
                                Grid.Row="1"
                                IsHitTestVisible="False"
                                Opacity="0.3">
                                <Border ap:AnimateFadeInProperty.Value="True" Background="{DynamicResource MahApps.Brushes.ThemeBackground}" />
                            </Border>
                        </Grid>
                    </Grid>

                    <!--  return string.Format("{0}, {1}, {2}", iii.Size.ToString_1(), iii.ColorsType.ToString(), iii.IconImageFormat.ToString());  -->
                    <TextBlock
                        Grid.Row="1"
                        Margin="0,2,0,0"
                        HorizontalAlignment="Center"
                        FlowDirection="LeftToRight"
                        Text="{Binding Index}">
                        <!--  FlowDirection="{lex:BLoc FlowDirection, TargetNullValue=LeftToRight}"  -->
                        <!--  Size  -->
                        <!--<Run>
                            <Run.Text>
                                <MultiBinding Converter="{conv:StringFormatConverter}" ConverterParameter="{}{0}x{1}">
                                    <Binding Path="Size.Width" />
                                    <Binding Path="Size.Height" />
                                </MultiBinding>
                            </Run.Text>
                        </Run>-->

                        <!--  ColorsType  -->
                        <!--<Run Text=", " /><lex:EnumRun
                            EnumValue="{Binding ColorsType}"
                            PrependType="True"
                            Separator="_" />-->
                        <!--  IconImageFormat  -->
                        <!--<Run Text=", " /><lex:EnumRun
                            EnumValue="{Binding IconImageFormat}"
                            PrependType="True"
                            Separator="_" />-->
                    </TextBlock>
                </Grid>
            </Border>
        </DataTemplate>

    </mm:MetroWindow.Resources>

    <Grid ap:ListViewHelper.DeselectOnMouseDown="{Binding ElementName=LV}">


        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ToolBar
            Grid.Row="0"
            MinHeight="50"
            HorizontalAlignment="Left">
            <Button
                Width="50"
                Command="{Binding BrowseForFileCommand}"
                ToolTip="{lex:BLoc BrowseForAnIconFile}">
                <Viewbox Margin="5">
                    <!--<iconPacks:PackIconFontAwesome Kind="FolderOpenSolid" />-->
                    <TextBlock
                        FontFamily="{StaticResource FontAwesome}"
                        Opacity="0.9"
                        Text="&#xf15B;" />
                    <!--<iconPacks:PackIconFontAwesome Kind="FileSolid" />-->
                </Viewbox>
            </Button>
            <Separator Margin="5,8" />
            <Button Width="50" ToolTip="{lex:BLoc Select_Icon_View, TargetNullValue=View}">
                <Viewbox Margin="5">
                    <TextBlock
                        FontFamily="{StaticResource FontAwesome}"
                        Opacity="0.9"
                        Text="&#xf0CE;" />
                    <!--<TextBlock FontFamily="{StaticResource FontAwesome}" Text="&#xf00A;" Opacity="0.9" />-->
                    <!--<TextBlock Text="&#xf107;" Opacity="0.8" />-->
                    <!--<iconPacks:PackIconFontAwesome Kind="ThSolid" />-->
                    <!--<iconPacks:PackIconFontAwesome Kind="ThListSolid" />-->
                    <!--<iconPacks:PackIconFontAwesome Kind="ThLargeSolid" />-->
                </Viewbox>
                <ap:ContextMenuHelper.OnClickContextMenu>
                    <ContextMenu DataContext="{Binding Source={x:Reference ViewModel}}">
                        <MenuItem
                            Header="{lex:BLoc Select_Icon_StretchedImage, TargetNullValue=Stretched Image}"
                            IsCheckable="True"
                            IsChecked="{Binding StretchedImages, Mode=TwoWay}"
                            Style="{StaticResource ViewSizeItem}" />
                        <MenuItem
                            Header="{lex:BLoc Select_Icon_StretchedSmallImagesToo, TargetNullValue=Stretch Small Images Too}"
                            IsCheckable="True"
                            IsChecked="{Binding StretchSmallImagesToo, Mode=TwoWay}"
                            IsEnabled="{Binding StretchedImages, Converter={conv:BoolWhenBoolConverter}}"
                            Style="{StaticResource ViewSizeItem}" />
                        <Separator />
                        <MenuItem
                            Header="16x16"
                            IsChecked="{Binding CurrentImageViewSizeW, Converter={conv:BoolWhenIntConverter When=16}}"
                            Style="{StaticResource ViewSizeItem}"
                            Tag="16" />
                        <MenuItem
                            Header="24x24"
                            IsChecked="{Binding CurrentImageViewSizeW, Converter={conv:BoolWhenIntConverter When=24}}"
                            Style="{StaticResource ViewSizeItem}"
                            Tag="24" />
                        <MenuItem
                            Header="32x32"
                            IsChecked="{Binding CurrentImageViewSizeW, Converter={conv:BoolWhenIntConverter When=32}}"
                            Style="{StaticResource ViewSizeItem}"
                            Tag="32" />
                        <MenuItem
                            Header="48x48"
                            IsChecked="{Binding CurrentImageViewSizeW, Converter={conv:BoolWhenIntConverter When=48}}"
                            Style="{StaticResource ViewSizeItem}"
                            Tag="48" />
                        <MenuItem
                            Header="64x64"
                            IsChecked="{Binding CurrentImageViewSizeW, Converter={conv:BoolWhenIntConverter When=64}}"
                            Style="{StaticResource ViewSizeItem}"
                            Tag="64" />
                        <MenuItem
                            Header="72x72"
                            IsChecked="{Binding CurrentImageViewSizeW, Converter={conv:BoolWhenIntConverter When=72}}"
                            Style="{StaticResource ViewSizeItem}"
                            Tag="72" />
                        <MenuItem
                            Header="80x80"
                            IsChecked="{Binding CurrentImageViewSizeW, Converter={conv:BoolWhenIntConverter When=80}}"
                            Style="{StaticResource ViewSizeItem}"
                            Tag="80" />
                        <MenuItem
                            Header="96x96"
                            IsChecked="{Binding CurrentImageViewSizeW, Converter={conv:BoolWhenIntConverter When=96}}"
                            Style="{StaticResource ViewSizeItem}"
                            Tag="96" />
                        <MenuItem
                            Header="128x128"
                            IsChecked="{Binding CurrentImageViewSizeW, Converter={conv:BoolWhenIntConverter When=128}}"
                            Style="{StaticResource ViewSizeItem}"
                            Tag="128" />
                        <MenuItem
                            Header="256x256"
                            IsChecked="{Binding CurrentImageViewSizeW, Converter={conv:BoolWhenIntConverter When=256}}"
                            Style="{StaticResource ViewSizeItem}"
                            Tag="256" />
                        <MenuItem
                            Header="512x512"
                            IsChecked="{Binding CurrentImageViewSizeW, Converter={conv:BoolWhenIntConverter When=512}}"
                            Style="{StaticResource ViewSizeItem}"
                            Tag="512" />
                    </ContextMenu>
                </ap:ContextMenuHelper.OnClickContextMenu>
            </Button>

        </ToolBar>

        <ComboBox
            Grid.Row="1"
            Margin="5"
            ap:TextBoxHelper.ClearFilterCommand="{Binding ClearCommand}"
            ap:TextBoxHelper.EditType="Path"
            ap:TextBoxHelper.FilterByEnterKey="True"
            ap:TextBoxHelper.FilterCommand="{Binding LoadIconsCommand}"
            ap:TextBoxHelper.IsFiltering="{Binding IsLoadingIcons}"
            ap:TextBoxHelper.RequireFilterAction="{Binding RequireRefresh}"
            ap:TextBoxHelper.RequireFilterButtonToolTip="{lex:BLoc Select_Icon_GetIcons, TargetNullValue=Get Icons}"
            mm:TextBoxHelper.UseFloatingWatermark="True"
            mm:TextBoxHelper.Watermark="{lex:BLoc FilePath, TargetNullValue=File Path}"
            IsReadOnly="{Binding IsWorking}"
            ItemsSource="{Binding RecentFilesWithDefaults, Source={x:Static serv:SettingsService.Instance}}"
            Style="{StaticResource PathComboBox2}"
            Text="{Binding FilePath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />


        <ListView
            x:Name="LV"
            Grid.Row="2"
            Margin="5"
            ap:ControlHelper.MouseWheelCommand="{Binding ChangeImageViewSizeDeltaCommand}"
            ap:ControlHelper.MouseWheelCommandOnControlKey="True"
            BorderBrush="{DynamicResource MahApps.Brushes.Controls.Border}"
            BorderThickness="1"
            ItemTemplate="{StaticResource ImageInfoTemplate}"
            ItemsSource="{Binding Icons}"
            SelectedItem="{Binding SelectedIconInfo}"
            SelectionMode="Single">
            <!--<ListView.Effect>
                <DropShadowEffect BlurRadius="5" ShadowDepth="1" />
            </ListView.Effect>-->
            <ListView.ContextMenu>
                <ContextMenu DataContext="{Binding Source={x:Reference ViewModel}}">
                    <MenuItem Command="{Binding OKCommand}" Header="{lex:BLoc Select_Icon_Select, TargetNullValue=Select}">
                        <MenuItem.IsEnabled>
                            <MultiBinding Converter="{conv:BoolWhenBoolConverter}">
                                <!--  {Binding IsWorking, Converter={conv:BooleanInvertConverter}}  -->
                                <Binding Converter="{conv:BooleanInvertConverter}" Path="IsWorking" />
                                <Binding Converter="{conv:BoolWhenNullConverter Value=False, Otherwise=True}" Path="SelectedIndex" />
                            </MultiBinding>
                        </MenuItem.IsEnabled>
                    </MenuItem>
                    <MenuItem
                        Command="{Binding ViewIconGroupCommandCommand}"
                        Header="{lex:BLoc Select_Icon_ShowIconGroup, TargetNullValue=Show Icon Group}"
                        IsEnabled="{Binding SelectedIconInfo, Converter={conv:BoolWhenNullConverter}}" />
                    <Separator />
                    <MenuItem Header="{lex:BLoc Select_Icon_View, TargetNullValue=View}">
                        <MenuItem
                            Header="{lex:BLoc Select_Icon_StretchedImage, TargetNullValue=Stretched Image}"
                            IsCheckable="True"
                            IsChecked="{Binding StretchedImages, Mode=TwoWay}"
                            Style="{StaticResource ViewSizeItem}" />
                        <MenuItem
                            Header="{lex:BLoc Select_Icon_StretchedSmallImagesToo, TargetNullValue=Stretch Small Images Too}"
                            IsCheckable="True"
                            IsChecked="{Binding StretchSmallImagesToo, Mode=TwoWay}"
                            IsEnabled="{Binding StretchedImages, Converter={conv:BoolWhenBoolConverter}}"
                            Style="{StaticResource ViewSizeItem}" />
                        <Separator />
                        <MenuItem
                            Header="16x16"
                            IsChecked="{Binding CurrentImageViewSizeW, Converter={conv:BoolWhenIntConverter When=16}}"
                            Style="{StaticResource ViewSizeItem}"
                            Tag="16" />
                        <MenuItem
                            Header="24x24"
                            IsChecked="{Binding CurrentImageViewSizeW, Converter={conv:BoolWhenIntConverter When=24}}"
                            Style="{StaticResource ViewSizeItem}"
                            Tag="24" />
                        <MenuItem
                            Header="32x32"
                            IsChecked="{Binding CurrentImageViewSizeW, Converter={conv:BoolWhenIntConverter When=32}}"
                            Style="{StaticResource ViewSizeItem}"
                            Tag="32" />
                        <MenuItem
                            Header="48x48"
                            IsChecked="{Binding CurrentImageViewSizeW, Converter={conv:BoolWhenIntConverter When=48}}"
                            Style="{StaticResource ViewSizeItem}"
                            Tag="48" />
                        <MenuItem
                            Header="64x64"
                            IsChecked="{Binding CurrentImageViewSizeW, Converter={conv:BoolWhenIntConverter When=64}}"
                            Style="{StaticResource ViewSizeItem}"
                            Tag="64" />
                        <MenuItem
                            Header="72x72"
                            IsChecked="{Binding CurrentImageViewSizeW, Converter={conv:BoolWhenIntConverter When=72}}"
                            Style="{StaticResource ViewSizeItem}"
                            Tag="72" />
                        <MenuItem
                            Header="80x80"
                            IsChecked="{Binding CurrentImageViewSizeW, Converter={conv:BoolWhenIntConverter When=80}}"
                            Style="{StaticResource ViewSizeItem}"
                            Tag="80" />
                        <MenuItem
                            Header="96x96"
                            IsChecked="{Binding CurrentImageViewSizeW, Converter={conv:BoolWhenIntConverter When=96}}"
                            Style="{StaticResource ViewSizeItem}"
                            Tag="96" />
                        <MenuItem
                            Header="128x128"
                            IsChecked="{Binding CurrentImageViewSizeW, Converter={conv:BoolWhenIntConverter When=128}}"
                            Style="{StaticResource ViewSizeItem}"
                            Tag="128" />
                        <MenuItem
                            Header="256x256"
                            IsChecked="{Binding CurrentImageViewSizeW, Converter={conv:BoolWhenIntConverter When=256}}"
                            Style="{StaticResource ViewSizeItem}"
                            Tag="256" />
                        <MenuItem
                            Header="512x512"
                            IsChecked="{Binding CurrentImageViewSizeW, Converter={conv:BoolWhenIntConverter When=512}}"
                            Style="{StaticResource ViewSizeItem}"
                            Tag="512" />
                    </MenuItem>
                    <Separator />
                    <MenuItem Command="{Binding LoadIconsCommand}" Header="{lex:BLoc Select_Icon_Refresh, TargetNullValue=Refresh}" />
                    <Separator />
                    <MenuItem
                        Command="{Binding ExportSelectedIconCommand}"
                        Header="{lex:BLoc Select_Icon_ExportIcon, TargetNullValue=Export Icon}"
                        IsEnabled="{Binding SelectedIconInfo, Converter={conv:BoolWhenNullConverter}}" />
                </ContextMenu>
            </ListView.ContextMenu>


            <ListView.ItemsPanel>
                <ItemsPanelTemplate>
                    <!--<WrapPanel />-->
                    <!--<UniformGrid Columns="3"  />-->
                    <!--<VirtualizingStackPanel
                        IsItemsHost="True" Orientation="Vertical"
                        IsVirtualizing="True"
                        KeyboardNavigation.DirectionalNavigation="Contained"
                        VirtualizationMode="Recycling"
                         Width="{Binding (FrameworkElement.ActualWidth), RelativeSource={RelativeSource AncestorType=ScrollContentPresenter}}"
                        MinWidth="{Binding (ListView.View).ItemWidth, RelativeSource={RelativeSource AncestorType=ListView}}"
                        />-->

                    <WrapPanel
                        Width="{Binding (FrameworkElement.ActualWidth), RelativeSource={RelativeSource AncestorType=ScrollContentPresenter}}"
                        MinWidth="{Binding (ListView.View).ItemWidth, RelativeSource={RelativeSource AncestorType=ListView}}"
                        IsItemsHost="True"
                        ItemHeight="{Binding (ListView.View).ItemHeight, RelativeSource={RelativeSource AncestorType=ListView}}"
                        ItemWidth="{Binding (ListView.View).ItemWidth, RelativeSource={RelativeSource AncestorType=ListView}}" />
                </ItemsPanelTemplate>
            </ListView.ItemsPanel>

        </ListView>

        <!--  Buttons  -->
        <!--<Grid Grid.Row="3">-->

        <Grid Grid.Row="3" HorizontalAlignment="Right">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button
                Grid.Column="0"
                Margin="5"
                HorizontalAlignment="Right"
                mm:ControlsHelper.ContentCharacterCasing="Upper"
                Command="{Binding CloseCommand}"
                Content="{lex:BLoc Select_Icon_Cancel, TargetNullValue=Cancel}"
                FontSize="{DynamicResource FontSizeLarge}"
                IsCancel="True" />

            <Button
                Grid.Column="1"
                Margin="5"
                HorizontalAlignment="Right"
                mm:ControlsHelper.ContentCharacterCasing="Upper"
                Command="{Binding OKCommand}"
                Content="{lex:BLoc Select_Icon_Select, TargetNullValue=Select}"
                FontSize="{DynamicResource FontSizeLarge}"
                IsDefault="True">
                <Button.IsEnabled>
                    <MultiBinding Converter="{conv:BoolWhenBoolConverter}">
                        <!--  {Binding IsWorking, Converter={conv:BooleanInvertConverter}}  -->
                        <Binding Converter="{conv:BooleanInvertConverter}" Path="IsWorking" />
                        <Binding Converter="{conv:BoolWhenNullConverter Value=False, Otherwise=True}" Path="SelectedIndex" />
                    </MultiBinding>
                </Button.IsEnabled>
            </Button>

        </Grid>
        <!--</Grid>-->

        <StatusBar
            Grid.Row="10"
            Background="{DynamicResource AccentColorBrush2}"
            FlowDirection="{lex:BLoc FlowDirection, TargetNullValue=LeftToRight}">
            <StatusBar.Effect>
                <DropShadowEffect
                    BlurRadius="15"
                    ShadowDepth="1"
                    Color="{DynamicResource AccentBaseColor}" />
            </StatusBar.Effect>
            <StatusBar.Resources>
                <Style x:Key="SeparatorStyle" TargetType="Separator">
                    <!--<Setter Property="Foreground" Value="{DynamicResource EzzWordRedBrush}" />-->
                    <Setter Property="Background" Value="{DynamicResource MahApps.Brushes.Gray5}" />
                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect
                                BlurRadius="8"
                                Direction="270"
                                ShadowDepth="1"
                                Color="{DynamicResource MahApps.Colors.Black}" />
                        </Setter.Value>
                    </Setter>
                    <Setter Property="Margin" Value="5,3" />
                </Style>
            </StatusBar.Resources>

            <!--  All Count  -->
            <Run Text="{lex:BLoc Select_Icon_Count, TargetNullValue=Count}" />
            <Run Text=":" />
            <Run Text="{Binding Items.Count, ElementName=LV, Mode=OneWay}" />

            <Separator Style="{StaticResource SeparatorStyle}" />

            <!--  Selected Count  -->
            <Run Text="{lex:BLoc Select_Icon_Index, TargetNullValue=Index}" />
            <Run Text=":" />
            <Run Text="{Binding SelectedItem.Index, ElementName=LV, Mode=OneWay}" />

            <Separator Style="{StaticResource SeparatorStyle}" />
            <TextBlock HorizontalAlignment="Right">
                <Run Text="{lex:BLoc Select_Icon_View, TargetNullValue=View}" />
                <Run Text=":" />
                <Run>
                    <Run.Text>
                        <MultiBinding Converter="{conv:StringFormatConverter}" ConverterParameter="{}{0}x{1}">
                            <Binding ElementName="ViewModel" Path="CurrentImageViewSizeW" />
                            <Binding ElementName="ViewModel" Path="CurrentImageViewSizeW" />
                        </MultiBinding>
                    </Run.Text>
                </Run>
            </TextBlock>

        </StatusBar>
    </Grid>
</mm:MetroWindow>
