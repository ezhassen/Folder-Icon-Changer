<local:IconImageControlBase
    x:Class="FolderIconChangerWPF.Controls.IconImageControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ap="clr-namespace:FolderIconChangerWPF.AttachedProperties"
    xmlns:conv="clr-namespace:FolderIconChangerWPF.ValueConverters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:lex="http://wpflocalizeextension.codeplex.com"
    xmlns:local="clr-namespace:FolderIconChangerWPF.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="128"
    d:DesignWidth="128"
    lex:LocalizeDictionary.DesignCulture="en"
    lex:LocalizeDictionary.OutputMissingKeys="True"
    lex:ResxLocalizationProvider.DefaultAssembly="Folder Icon Changer"
    lex:ResxLocalizationProvider.DefaultDictionary="Resources"
    MouseEnter="IconImageControlBase_MouseEnter"
    MouseLeave="IconImageControlBase_MouseLeave"
    mc:Ignorable="d">

    <Grid DataContext="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=local:IconImageControlBase}}">
        <Image Margin="5"
            x:Name="ImageControl"
            Source="{Binding ImageSource}"
            Stretch="{Binding ImageStretch}"
            StretchDirection="{Binding ImageStretchDirection}" />

        <Grid Visibility="{Binding IsLoading, Converter={conv:VisibilityWhenTrueConverter}}">
            <Viewbox
                Margin="20"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
                <TextBlock Style="{StaticResource SpinningText}" />
            </Viewbox>
            <Border
                Grid.Row="1"
                IsHitTestVisible="False"
                Opacity="0.3">
                <Border ap:AnimateFadeInProperty.Value="True" Background="{DynamicResource WhiteBrush}" />
            </Border>
        </Grid>

        <Grid
            x:Name="CommandsGrid"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Bottom">

            <Border
                x:Name="PART_CommandsPanel"
                HorizontalAlignment="Center"
                VerticalAlignment="Stretch"
                ap:AnimateFadeInProperty.Value="{Binding RelativeSource={RelativeSource Self}, Path=Visibility, Converter={conv:BoolWhenVisibilityConverter}}"
                Background="{DynamicResource SemiTransparentGreyBrush}"
                CornerRadius="5"
                Visibility="Hidden">

                <Border.Resources>
                    <!--<DropShadowEffect
                        x:Key="ButtonsDropShadowEffect"
                        BlurRadius="20"
                        Direction="290"
                        ShadowDepth="0" />
                    <DropShadowEffect
                        x:Key="IconDropShadowEffect"
                        BlurRadius="2"
                        Direction="275"
                        ShadowDepth="1"
                        Color="{DynamicResource BlackColor}" />-->

                    <Style BasedOn="{StaticResource MetroButton}" TargetType="Button">
                        <!--<Setter Property="Effect" Value="{StaticResource ButtonsDropShadowEffect}" />-->
                        <Setter Property="IsEnabled" Value="{Binding Path=IconInfo, Converter={conv:BoolWhenNullConverter Value=False, Otherwise=True}}" />
                        <Setter Property="Margin" Value="5" />
                        <Setter Property="Padding" Value="5" />
                    </Style>
                </Border.Resources>
                <StackPanel Orientation="Horizontal">
                    <!--<StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Style.Triggers>
                            <Trigger SourceName="CommandsGrid" Property="IsMouseOver" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>-->
                    <Button Command="{Binding Path=ViewIconGroupCommand}" ToolTip="{lex:BLoc ShowIconGroup, TargetNullValue=Show icon group}">
                        <!--<iconPacks:PackIconFontAwesome Kind="EyeRegular" />-->
                        <TextBlock
                            FontFamily="{StaticResource FontAwesome}"
                            FontSize="{StaticResource FontSizeLarge}"
                            Text="{StaticResource FontAwesomeEye}" />

                        <!--<iconPacks:PackIconMaterial Kind="FileExport"
                            Effect="{StaticResource IconDropShadowEffect}"

                        />-->
                    </Button>
                    <Button Command="{Binding GenerateBestFitCommand}" ToolTip="{lex:BLoc GenerateBestFit, TargetNullValue={}Generate Best Icon Fit}">

                        <!--  Visibility="{Binding GenerateBestFitCommand, Converter={conv:VisibilityWhenNullConverter  Value=Collapsed, Otherwise=Visible}}"  -->

                        <TextBlock
                            FontFamily="{StaticResource FontAwesome}"
                            FontSize="{StaticResource FontSizeLarge}"
                            Text="{StaticResource FontAwesomeExpand}" />
                        <!--<iconPacks:PackIconFontAwesome Kind="ExpandSolid" />-->

                        <!--<iconPacks:PackIconMaterial Kind="FileExport"
                            Effect="{StaticResource IconDropShadowEffect}"
                        />-->
                        <!--  <x:Array  -->
                        <Button.Visibility>
                            <MultiBinding Converter="{conv:VisibilityWhenBoolConverter MultiWhenAny=False, When=True, Value=Visible, Otherwise=Collapsed}">
                                <!--<MultiBinding.Converter>
                                    <conv:VisibilityWhenConverter
                                        MultiWhenAny="True"
                                        Otherwise="Visible"
                                        Value="Collapsed">
                                        <conv:VisibilityWhenConverter.MultiWhen>
                                            <sysCollections:ArrayList>
                                                <sys:Boolean>False</sys:Boolean>
                                -->
                                <!--  OR  -->
                                <!--
                                                <x:Null />
                                            </sysCollections:ArrayList>
                                        </conv:VisibilityWhenConverter.MultiWhen>
                                    </conv:VisibilityWhenConverter>
                                </MultiBinding.Converter>-->

                                <Binding Converter="{conv:BoolWhenBoolConverter}" Path="AllowToGenerateBestFit" />
                                <Binding Converter="{conv:BoolWhenNullConverter Value=False, Otherwise=True}" Path="GenerateBestFitCommand" />
                                <!--<Binding Path="GenerateBestFitCommand"/>-->
                            </MultiBinding>
                        </Button.Visibility>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>

    </Grid>
</local:IconImageControlBase>
