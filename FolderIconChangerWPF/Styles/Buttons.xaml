<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ap="clr-namespace:FolderIconChangerWPF.AttachedProperties"
    xmlns:lex="http://wpflocalizeextension.codeplex.com"
    xmlns:local="clr-namespace:FolderIconChangerWPF"
    xmlns:mmcontrols="http://metro.mahapps.com/winfx/xaml/controls"
    xmlns:mmshared="http://metro.mahapps.com/winfx/xaml/shared"
    xmlns:vconverters="clr-namespace:FolderIconChangerWPF.ValueConverters">


    <!--<ResourceDictionary.MergedDictionaries>

    -->
    <!--  Order is important  -->

    <!--<ResourceDictionary Source="Colors.xaml" />-->
    <!--
        <ResourceDictionary Source="Fonts.xaml" />
        <ResourceDictionary Source="Texts.xaml" />
