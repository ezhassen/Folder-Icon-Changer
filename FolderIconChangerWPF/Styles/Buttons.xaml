    <Style
        x:Key="CloseCustomLightMetroWindowButtonStyle"
        BasedOn="{StaticResource CustomLightMetroWindowButtonStyleBase}"
        TargetType="{x:Type Button}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}">
                        <!--<Image
                            x:Name="WindowCloseImage"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Source="{DynamicResource WindowCloseIconDrawingImage}"
                            Stretch="None" />-->
                        <Grid>
                            <Line
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                SnapsToDevicePixels="True"
                                Stroke="{DynamicResource GrayBrush1}"
                                X1="0"
                                X2="10"
                                Y1="0"
                                Y2="10" />
                            <Line
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                SnapsToDevicePixels="True"
                                Stroke="{DynamicResource GrayBrush1}"
                                X1="0"
                                X2="10"
                                Y1="10"
                                Y2="0" />
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="ToolTip">
            <Setter.Value>
                <ToolTip>
                    <StackPanel>
                        <lex:LocProxy PrependType="True" Source="{Binding}" />
                        <TextBlock FontWeight="Bold" Text="{lex:BLoc WindowCloseToolTip}" />
                        <!--<TextBlock>Submits the request to the server.</TextBlock>-->
                    </StackPanel>
                </ToolTip>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource WindowCloseHoverBrush}" />
                <!--<Setter Property="Foreground" Value="White" />-->
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type Button}">
                            <Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}">
                                <!--<Image
                                    x:Name="WindowCloseImage"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Source="{DynamicResource WindowCloseWhiteIconDrawingImage}"
                                    Stretch="None" />-->
                                <Grid>
                                    <Line
