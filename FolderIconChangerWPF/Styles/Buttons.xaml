    <!--  Hoverless button  -->
    <Style x:Key="Hoverless" TargetType="{x:Type Button}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  System Icon Button  -->
    <Style
        x:Key="SystemIconButton"
        BasedOn="{StaticResource Hoverless}"
        TargetType="{x:Type Button}">

        <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
        <Setter Property="Margin" Value="10" />

    </Style>
    <!--#region Window Commands-->
    <!--  Window Control Button  -->
    <Style x:Key="WindowControlButton" TargetType="{x:Type Button}">
        <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="8" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="Foreground" Value="{StaticResource GrayBrush1}" />

        <Setter Property="LayoutTransform">
            <Setter.Value>
                <ScaleTransform ScaleX="1.5" />
            </Setter.Value>
        </Setter>

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}">
                        <TextBlock
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Text="{TemplateBinding Content}" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>

        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource BackgroundLightBrush}" />
            </Trigger>
        </Style.Triggers>

    </Style>

    <Style x:Key="WindowControlButtonBase" TargetType="{x:Type Button}">
        <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
        <!--<Setter Property="Foreground" Value="{StaticResource WindowActionsForegroundBrush}" />-->
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="8" />
        <Setter Property="Width" Value="35" />
        <Setter Property="VerticalAlignment" Value="Stretch" />

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}">
                        <Image
                            x:Name="WindowCloseImage"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Source="{TemplateBinding Content}"
                            Stretch="Uniform" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!--  Window Minimize Button  -->
    <Style
        x:Key="WindowMinimizeButton"
        BasedOn="{StaticResource WindowControlButtonBase}"
        TargetType="{x:Type Button}">
        <Setter Property="Content" Value="{DynamicResource WindowMinimizeIconDrawingImage}" />

        <Setter Property="ToolTip">
            <Setter.Value>
                <ToolTip>
                    <StackPanel>
                        <lex:LocProxy PrependType="True" Source="{Binding}" />
                        <TextBlock FontWeight="Bold" Text="{lex:BLoc WindowMinimizeToolTip}" />
                        <!--<TextBlock>Submits the request to the server.</TextBlock>-->
                    </StackPanel>
                </ToolTip>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource WindowActionsHoverBrush}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{DynamicResource WindowActionsPressedBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>
    <!--  Window Maximized/Restore  Button  -->
    <Style
        x:Key="WindowMaximizeButton"
        BasedOn="{StaticResource WindowControlButtonBase}"
        TargetType="{x:Type Button}">
        <Setter Property="Content" Value="{DynamicResource WindowMaximizeIconDrawingImage}" />
        <Setter Property="ToolTip">
            <Setter.Value>
                <ToolTip>
                    <StackPanel>
                        <lex:LocProxy
                            Name="Proxy0"
                            PrependType="True"
                            Source="{Binding}" />
                        <TextBlock FontWeight="Bold" Text="{lex:BLoc WindowMaximizeToolTip}" />
                        <!--<TextBlock>Submits the request to the server.</TextBlock>-->
                    </StackPanel>
                </ToolTip>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized">
                <Setter Property="Content" Value="{DynamicResource WindowRestoreIconDrawingImage}" />
                <Setter Property="ToolTip">
                    <Setter.Value>
                        <ToolTip>
                            <StackPanel>
                                <lex:LocProxy PrependType="True" Source="{Binding}" />
                                <TextBlock FontWeight="Bold" Text="{lex:BLoc WindowRestoreToolTip}" />
                                <!--<TextBlock>Submits the request to the server.</TextBlock>-->
                            </StackPanel>
                        </ToolTip>
                    </Setter.Value>
                </Setter>
            </DataTrigger>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource WindowActionsHoverBrush}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{DynamicResource WindowActionsPressedBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>
