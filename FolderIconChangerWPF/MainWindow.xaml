<mm:MetroWindow
    x:Class="FolderIconChangerWPF.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ap="clr-namespace:FolderIconChangerWPF.AttachedProperties"
    xmlns:controls="clr-namespace:FolderIconChangerWPF.Controls"
    xmlns:conv="clr-namespace:FolderIconChangerWPF.ValueConverters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:lex="http://wpflocalizeextension.codeplex.com"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:mm="http://metro.mahapps.com/winfx/xaml/controls"
    xmlns:serv="clr-namespace:FolderIconChangerWPF.Services"
    xmlns:vm="clr-namespace:FolderIconChangerWPF.ViewModels"
    Title="{lex:BLoc MainFormTitle, FallbackValue={}Folder Icon Changer}"
    Width="520"
    MinWidth="520"
    MinHeight="480"
    ap:ControlHelper.DragNDropCommand="{Binding DragNDropCommand}"
    lex:LocalizeDictionary.DesignCulture="en"
    lex:LocalizeDictionary.OutputMissingKeys="True"
    lex:ResxLocalizationProvider.DefaultAssembly="Folder Icon Changer"
    lex:ResxLocalizationProvider.DefaultDictionary="Resources"
    DataContext="{Binding Source={x:Static vm:ApplicationViewModel.Instance}}"
    Icon="Icon.ico"
    IconOverlayBehavior="Always"
    NonActiveWindowTitleBrush="{DynamicResource MahApps.Brushes.Window.Background}"
    OverlayBrush="Red"
    ResizeMode="CanMinimize"
    ShowIconOnTitleBar="False"
    SizeToContent="Height"
    TitleAlignment="Stretch"
    TitleTemplate="{StaticResource WindowTitleTemplateBig}" 
    TitleBarHeight="42"
    WindowButtonCommandsOverlayBehavior="Always"
    WindowStartupLocation="CenterScreen"
    WindowTitleBrush="{DynamicResource MahApps.Brushes.Window.Background}"
    mc:Ignorable="d">
    <!--  LeftWindowCommands="{DynamicResource MainWindowLeftCommands}"  -->
    <!--<mm:MetroWindow.Resources />-->
    <!--  Topmost="{Binding IsTopMost, Source={x:Static serv:SettingsService.Instance}, Mode=OneWay}"  -->

    <mm:MetroWindow.LeftWindowCommands>
        <mm:WindowCommands ShowLastSeparator="False" ShowSeparators="False">

            <!--  App Menu  -->
            <ToggleButton
                MinWidth="20"
                MinHeight="20"
                Margin="8,10,5,8"
                Cursor="Hand"
                Foreground="{DynamicResource MahApps.Brushes.Gray1}"
                ToolTip="{lex:BLoc MainWindowMenu, TargetNullValue=Menu}">
                <ToggleButton.Effect>
                    <DropShadowEffect
                        BlurRadius="10"
                        Direction="250"
                        Opacity=".6"
                        ShadowDepth="3" />
                </ToggleButton.Effect>
                <ToggleButton.Content>
                    <Viewbox>
                        <Viewbox.Effect>
                            <DropShadowEffect
                                BlurRadius="3"
                                Direction="250"
                                Opacity=".6"
                                ShadowDepth="2" />
                        </Viewbox.Effect>
                        <!--<iconPacks:PackIconMaterial Kind="Settings" />-->
                        <TextBlock FontFamily="{StaticResource FontAwesome}" Text="&#xf142;" />
                        <!--<iconPacks:PackIconFontAwesome Kind="EllipsisVSolid" />-->
                    </Viewbox>
                </ToggleButton.Content>
                <ToggleButton.Resources>

                    <Thickness x:Key="SeparatorMargin">-10,0,10,0</Thickness>
                    <Thickness x:Key="MenuIconMargin">5,0</Thickness>
                    <Thickness x:Key="MenuIconPadding">-3</Thickness>

                    <DropShadowEffect
                        x:Key="ToggleButtonShadowEffect"
                        BlurRadius="10"
                        Direction="250"
                        Opacity=".6"
                        ShadowDepth="3" />
                    <DropShadowEffect
                        x:Key="ButtonShadowEffect"
                        BlurRadius="3"
                        Direction="250"
                        Opacity=".6"
                        ShadowDepth="2" />

                    <Style x:Key="NormalMenuItem" TargetType="MenuItem">
                        <Setter Property="FontSize" Value="{StaticResource FontSizeRegular}" />
                        <Setter Property="Foreground" Value="{DynamicResource MahApps.Brushes.Text}" />

                        <Setter Property="HeaderTemplate">
                            <Setter.Value>
                                <ItemContainerTemplate>
                                    <!--  TemplatedParent  -->
                                    <TextBlock
                                        Margin="5"
                                        HorizontalAlignment="Stretch"
                                        VerticalAlignment="Center"
                                        Effect="{StaticResource ToggleButtonShadowEffect}"
                                        FontSize="{DynamicResource FontSizeLarge}"
                                        Foreground="{DynamicResource MahApps.Brushes.Text}"
                                        Text="{Binding Header, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=MenuItem}}"
                                        TextTrimming="CharacterEllipsis"
                                        ToolTip="{Binding Text, RelativeSource={RelativeSource Mode=Self}}" />
                                </ItemContainerTemplate>
                            </Setter.Value>
                        </Setter>
                        <!--<Setter Property="Icon">
                        <Setter.Value>
                            <Viewbox Margin="5,0" StretchDirection="Both">
                                <iconPacks:PackIconMaterial
                                    Margin="5,0"
                                    Padding="-5"
                                    Effect="{StaticResource ButtonShadowEffect}"
                                    Foreground="{DynamicResource MahApps.Brushes.AccentBase}"
                                    Kind="{Binding Tag, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=MenuItem}}" />
                            </Viewbox>
                        </Setter.Value>
                    </Setter>-->
                        <Setter Property="MinHeight" Value="42" />
                        <Setter Property="ToolTip" Value="{Binding Header, RelativeSource={RelativeSource Mode=Self}}" />
                    </Style>
                </ToggleButton.Resources>

                <ap:ContextMenuHelper.ToggleButtonContextMenu>
                    <ContextMenu
                        MinWidth="160"
                        FlowDirection="{lex:BLoc FlowDirection, TargetNullValue=LeftToRight}"
                        HorizontalOffset="-40"
                        Placement="Bottom"
                        RenderOptions.ClearTypeHint="Enabled"
                        SnapsToDevicePixels="True"
                        StaysOpen="False"
                        TextOptions.TextFormattingMode="Ideal"
                        VerticalOffset="0">
                        <MenuItem
                            x:Name="AppMenu_SettingsPageItem"
                            Command="{Binding GoToPageCommand, Source={x:Static vm:ApplicationViewModel.Instance}}"
                            CommandParameter="SettingsPage"
                            Header="{lex:BLoc Settings, TargetNullValue={}Settings}"
                            Style="{StaticResource NormalMenuItem}"
                            Visibility="{Binding CurrentPage, Source={x:Static vm:ApplicationViewModel.Instance}, Converter={conv:VisibilityWhenStringConverter When=SettingsPage, Value=Collapsed, Otherwise=Visible}}">
                            <MenuItem.Icon>
                                <Viewbox Margin="5,0" StretchDirection="Both">
                                    <TextBlock
                                        Margin="{StaticResource MenuIconMargin}"
                                        Effect="{StaticResource ButtonShadowEffect}"
                                        FontFamily="{StaticResource FontAwesome}"
                                        FontSize="{StaticResource FontSizeLarge}"
                                        Foreground="{DynamicResource MahApps.Brushes.AccentBase}"
                                        Text="{StaticResource FontAwesomeCogIcon}" />

                                    <!--<iconPacks:PackIconMaterial
                                        Margin="{StaticResource MenuIconMargin}"
                                        Padding="{StaticResource MenuIconPadding}"
                                        Effect="{StaticResource ButtonShadowEffect}"
                                        Foreground="{DynamicResource MahApps.Brushes.AccentBase}"
                                        Kind="Settings" />-->
                                </Viewbox>
                            </MenuItem.Icon>
                        </MenuItem>
                        <Separator Margin="{StaticResource SeparatorMargin}" Visibility="{Binding CurrentPage, Source={x:Static vm:ApplicationViewModel.Instance}, Converter={conv:VisibilityWhenStringConverter When=SettingsPage, Value=Collapsed, Otherwise=Visible}}" />
                        <MenuItem
                            x:Name="AppMenu_AboutPage"
                            Command="{Binding GoToPageCommand, Source={x:Static vm:ApplicationViewModel.Instance}}"
                            CommandParameter="AboutPage"
                            Header="{lex:BLoc About, TargetNullValue={}About}"
                            Style="{StaticResource NormalMenuItem}"
                            Visibility="{Binding CurrentPage, Source={x:Static vm:ApplicationViewModel.Instance}, Converter={conv:VisibilityWhenStringConverter When=AboutPage, Value=Collapsed, Otherwise=Visible}}">
                            <MenuItem.Icon>
                                <Viewbox Margin="5,0" StretchDirection="Both">
                                    <TextBlock
                                        Margin="{StaticResource MenuIconMargin}"
                                        Effect="{StaticResource ButtonShadowEffect}"
                                        FontFamily="{StaticResource FontAwesome}"
                                        FontSize="{StaticResource FontSizeLarge}"
                                        Foreground="{DynamicResource MahApps.Brushes.AccentBase}"
                                        Text="{StaticResource FontAwesomeInfoCircleSolid}" />

                                    <!--<iconPacks:PackIconMaterial
                                        Margin="{StaticResource MenuIconMargin}"
                                        Padding="{StaticResource MenuIconPadding}"
                                        Effect="{StaticResource ButtonShadowEffect}"
                                        Foreground="{DynamicResource MahApps.Brushes.AccentBase}"
                                        Kind="Information" />-->
                                </Viewbox>
                            </MenuItem.Icon>
                        </MenuItem>
                        <Separator Margin="{StaticResource SeparatorMargin}" Visibility="{Binding CurrentPage, Source={x:Static vm:ApplicationViewModel.Instance}, Converter={conv:VisibilityWhenStringConverter When=AboutPage, Value=Collapsed, Otherwise=Visible}}" />
                        <MenuItem
                            Command="{Binding AppExitCommand, Source={x:Static vm:ApplicationViewModel.Instance}}"
                            FontSize="{StaticResource FontSizeRegular}"
                            Foreground="{DynamicResource MahApps.Brushes.Text}"
                            Header="{lex:BLoc Exit, TargetNullValue={}Exit}"
                            ToolTip="{Binding Header, RelativeSource={RelativeSource Mode=Self}}">

                            <MenuItem.Icon>
                                <!--<iconPacks:PackIconOcticons Margin="5,0" Kind="SignOut" />-->
                                <Viewbox Margin="5,0">
                                    <!--<iconPacks:PackIconFontAwesome
                                                Margin="{StaticResource MenuIconMargin}"
                                                Effect="{StaticResource ButtonShadowEffect}"
                                                Foreground="{DynamicResource EzzWordRedBrush}"
                                                Kind="WindowCloseSolid" />-->
                                    <!--<iconPacks:PackIconMaterial
                                        Margin="{StaticResource MenuIconMargin}"
                                        Effect="{StaticResource ButtonShadowEffect}"
                                        Foreground="{DynamicResource EzzWordRedBrush}"
                                        Kind="CloseBox" />-->
                                    <TextBlock
                                        Margin="{StaticResource MenuIconMargin}"
                                        Effect="{StaticResource ButtonShadowEffect}"
                                        FontFamily="{StaticResource FontAwesome}"
                                        FontSize="{StaticResource FontSizeLarge}"
                                        Foreground="{DynamicResource EzzWordRedBrush}"
                                        Text="{StaticResource FontAwesomeTimesSquareSolid}" />

                                </Viewbox>
                            </MenuItem.Icon>
                        </MenuItem>
                    </ContextMenu>
                </ap:ContextMenuHelper.ToggleButtonContextMenu>

            </ToggleButton>
            <!--  Home  -->
            <Button
                Margin="5"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Command="{Binding GoToPageCommand}"
                CommandParameter="MainPage"
                Cursor="Hand"
                DataContext="{Binding Source={x:Static vm:ApplicationViewModel.Instance}}"
                Foreground="{DynamicResource MahApps.Brushes.Gray1}"
                Style="{StaticResource MahApps.Styles.Button.Chromeless}"
                Visibility="{Binding CurrentPage, Converter={conv:VisibilityWhenStringConverter When=MainPage, Value=Collapsed, Otherwise=Visible}}">
                <Viewbox>
                    <!--<iconPacks:PackIconFontAwesome Kind="ArrowLeftSolid" />-->
                    <!--<iconPacks:PackIconFontAwesome Kind="HomeSolid" />-->
                    <TextBlock FontFamily="{StaticResource FontAwesome}" Text="{StaticResource FontAwesomeHomeSolid}" />
                </Viewbox>
            </Button>
            <!--<Separator Style="{StaticResource WindowCommandsSeparator}" />-->
            <!--  Language Selection  -->
            <mm:DropDownButton
                Margin="5,1,1,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                HorizontalContentAlignment="Stretch"
                VerticalContentAlignment="Stretch"
                ArrowVisibility="Collapsed"
                Background="{DynamicResource MahApps.Brushes.Window.Background}"
                BorderThickness="0"
                Cursor="Hand"
                FlowDirection="LeftToRight"
                ItemsSource="{Binding Source={x:Static serv:SettingsService.Instance}, Path=SupportedCultures}"
                ToolTip="{Binding Source={x:Static serv:SettingsService.Instance}, Path=SelectedCulture.NativeName}">
                <!--  FlowDirection="{lex:BLoc FlowDirection, TargetNullValue=LeftToRight}"  -->
                <mm:DropDownButton.Icon>
                    <Image
                        Width="45"
                        Height="35"
                        Source="{Binding Source={x:Static serv:SettingsService.Instance}, Path=SelectedCulture, Converter={conv:CultureToImageConverter}}"
                        Stretch="Uniform">
                        <Image.Effect>
                            <DropShadowEffect
                                BlurRadius="8"
                                Direction="290"
                                Opacity="1"
                                ShadowDepth="1" />
                        </Image.Effect>
                    </Image>
                </mm:DropDownButton.Icon>

                <mm:DropDownButton.ItemContainerStyle>
                    <Style TargetType="MenuItem">
                        <Setter Property="Command" Value="{Binding Source={x:Static serv:SettingsService.Instance}, Path=ChangeSelectedCultureCommand}" />
                        <Setter Property="CommandParameter" Value="{Binding}" />
                        <Setter Property="HeaderTemplate">
                            <Setter.Value>
                                <ItemContainerTemplate>
                                    <StackPanel Margin="0,5,0,5" Orientation="Horizontal">
                                        <Image
                                            Width="45"
                                            Height="35"
                                            Source="{Binding Converter={conv:CultureToImageConverter}}"
                                            Stretch="Uniform">
                                            <Image.Effect>
                                                <DropShadowEffect
                                                    BlurRadius="8"
                                                    Direction="290"
                                                    Opacity="1"
                                                    ShadowDepth="1" />
                                            </Image.Effect>
                                        </Image>
                                        <TextBlock
                                            Margin="2,0,0,0"
                                            HorizontalAlignment="Stretch"
                                            VerticalAlignment="Center"
                                            FontFamily="{DynamicResource LatoRegular}"
                                            FontSize="{DynamicResource FontSizeSmall}"
                                            FontWeight="Bold"
                                            TextAlignment="Center">
                                            <TextBlock Visibility="{Binding DisplayName, Mode=OneWay, Converter={conv:VisibilityWhenStringConverter When=English, Value=Collapsed, Otherwise=Visible}}"><Run Foreground="{StaticResource EzzWordBlueBrush}" Text="{Binding DisplayName, Mode=OneWay}" /></TextBlock>
                                            <Run Foreground="{DynamicResource EzzWordOrangeBrush}" Text="{}{" />
                                            <Run
                                                FontWeight="Bold"
                                                Foreground="{DynamicResource EzzWordRedBrush}"
                                                Text="{Binding NativeName, Mode=OneWay}" />
                                            <Run Foreground="{DynamicResource EzzWordOrangeBrush}" Text="}" />
                                        </TextBlock>
                                    </StackPanel>
                                </ItemContainerTemplate>
                            </Setter.Value>
                        </Setter>
                        <Setter Property="HorizontalAlignment" Value="Stretch" />
                        <Setter Property="Margin" Value="-15,0,0,0" />
                    </Style>
                </mm:DropDownButton.ItemContainerStyle>
            </mm:DropDownButton>
            <!--<ContentControl Content="{StaticResource LanguageSelectionTemplateDropDownButton}" />-->
            <!--<ContentPresenter Content="{StaticResource LanguageSelectionTemplateComboBox}" />-->
            <!--  Theme Selection  -->
            <!--<ContentPresenter ContentTemplate="{StaticResource ThemeSelectionTemplateComboBox}" />-->
            <mm:DropDownButton
                Margin="0,1,1,1"
                Padding="1"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                HorizontalContentAlignment="Stretch"
                VerticalContentAlignment="Stretch"
                ArrowVisibility="Collapsed"
                Background="{DynamicResource MahApps.Brushes.Window.Background}"
                BorderThickness="0"
                Cursor="Hand"
                FlowDirection="{lex:BLoc FlowDirection, TargetNullValue=LeftToRight}"
                ItemsSource="{Binding Source={x:Static serv:SettingsService.Instance}, Path=Themes}"
                ToolTip="{Binding Source={x:Static serv:SettingsService.Instance}, Path=SelectedTheme.LocalizedDisplayName}">

                <mm:DropDownButton.Icon>
                    <Viewbox Stretch="Uniform">
                        <StackPanel
                            Margin="10"
                            DataContext="{Binding Source={x:Static serv:SettingsService.Instance}, Path=SelectedTheme}"
                            Orientation="Horizontal">
                            <Ellipse
                                Width="25"
                                Height="25"
                                Fill="{Binding BackgroundBrush}"
                                Stretch="Uniform"
                                Stroke="{Binding ForegroundBrush}"
                                StrokeThickness="1.5">
                                <Ellipse.Effect>
                                    <DropShadowEffect
                                        BlurRadius="8"
                                        Direction="290"
                                        Opacity="1"
                                        ShadowDepth="1" />
                                </Ellipse.Effect>
                            </Ellipse>
                        </StackPanel>
                    </Viewbox>
                </mm:DropDownButton.Icon>
                <mm:DropDownButton.ItemContainerStyle>
                    <Style TargetType="MenuItem">
                        <Setter Property="Command" Value="{Binding Source={x:Static serv:SettingsService.Instance}, Path=ChangeSelectedThemeCommand}" />
                        <Setter Property="CommandParameter" Value="{Binding}" />
                        <Setter Property="HeaderTemplate">
                            <Setter.Value>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse
                                            Width="25"
                                            Height="25"
                                            Margin="10"
                                            Fill="{Binding BackgroundBrush}"
                                            Stretch="Uniform"
                                            Stroke="{Binding ForegroundBrush}"
                                            StrokeThickness="1.5">
                                            <Ellipse.Effect>
                                                <DropShadowEffect
                                                    BlurRadius="8"
                                                    Direction="290"
                                                    Opacity="1"
                                                    ShadowDepth="1" />
                                            </Ellipse.Effect>
                                        </Ellipse>
                                        <TextBlock
                                            Margin="2,0,0,0"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center"
                                            FontFamily="{StaticResource LatoRegular}"
                                            FontSize="{StaticResource FontSizeRegular}"
                                            FontWeight="Bold"
                                            Text="{Binding LocalizedDisplayName}"
                                            TextAlignment="Center" />
                                    </StackPanel>
                                </DataTemplate>
                            </Setter.Value>
                        </Setter>
                        <Setter Property="HorizontalAlignment" Value="Stretch" />
                        <Setter Property="Margin" Value="-15,0,0,0" />
                    </Style>
                </mm:DropDownButton.ItemContainerStyle>
            </mm:DropDownButton>
        </mm:WindowCommands>
    </mm:MetroWindow.LeftWindowCommands>
    <mm:MetroWindow.RightWindowCommands>
        <mm:WindowCommands ShowLastSeparator="True" ShowSeparators="True">
            <ToggleButton
                Margin="5,0"
                Padding="6"
                Background="Transparent"
                BorderThickness="0"
                Cursor="Hand"
                Foreground="{DynamicResource MahApps.Brushes.AccentBase}"
                IsChecked="{Binding IsTopMost, Source={x:Static serv:SettingsService.Instance}, Mode=TwoWay}"
                ToolTip="{lex:BLoc TopMost, TargetNullValue={}Stay On Top}">
                <ToggleButton.Effect>
                    <DropShadowEffect
                        BlurRadius="10"
                        Direction="250"
                        Opacity=".6"
                        ShadowDepth="3" />
                </ToggleButton.Effect>
                <ToggleButton.Content>
                    <!--<iconPacks:PackIconFontAwesome Kind="ThumbtackSolid" />-->
                    <Viewbox>
                        <Viewbox.Effect>
                            <DropShadowEffect
                                BlurRadius="3"
                                Direction="250"
                                Opacity=".6"
                                ShadowDepth="2" />
                        </Viewbox.Effect>
                        <TextBlock Text="&#xf08d;">
                            <!--<TextBlock.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform />
                                <SkewTransform />
                                <RotateTransform Angle="130" />
                                <TranslateTransform />
                            </TransformGroup>
                        </TextBlock.RenderTransform-->
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontFamily" Value="{StaticResource FontAwesome}" />
                                    <Setter Property="RenderTransform">
                                        <Setter.Value>
                                            <RotateTransform Angle="130" />
                                        </Setter.Value>
                                    </Setter>
                                    <Setter Property="RenderTransformOrigin" Value="0.5, 0.5" />
                                    <!--<Setter Property="Text" Value="&#xf08d;" />-->
                                    <Style.Resources>
                                        <Storyboard x:Key="ToPin">
                                            <DoubleAnimation
                                                Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                From="130"
                                                To="0"
                                                Duration="0:0:0.2" />
                                        </Storyboard>
                                        <Storyboard x:Key="ToPinOff">
                                            <DoubleAnimation
                                                Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                From="0"
                                                To="130"
                                                Duration="0:0:0.2" />
                                        </Storyboard>
                                    </Style.Resources>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=ToggleButton}}" Value="True">
                                            <!--<Setter Property="Text" Value="sss" />-->
                                            <DataTrigger.EnterActions>
                                                <BeginStoryboard Name="ToPinStoryboard" Storyboard="{StaticResource ToPin}" />
                                            </DataTrigger.EnterActions>
                                            <DataTrigger.ExitActions>
                                                <RemoveStoryboard BeginStoryboardName="ToPinStoryboard" />
                                            </DataTrigger.ExitActions>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=ToggleButton}}" Value="False">
                                            <DataTrigger.EnterActions>
                                                <BeginStoryboard Name="ToPinOffStoryboard" Storyboard="{StaticResource ToPinOff}" />
                                            </DataTrigger.EnterActions>
                                            <DataTrigger.ExitActions>
                                                <RemoveStoryboard BeginStoryboardName="ToPinOffStoryboard" />
                                            </DataTrigger.ExitActions>
                                        </DataTrigger>


                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>

                        </TextBlock>

                        <!--<iconPacks:PackIconMaterial Kind="Settings" />-->
                        <!--<Grid>-->
                        <!--<iconPacks:PackIconMaterial Kind="PinOff" Visibility="{Binding IsChecked, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=ToggleButton}, Converter={conv:VisibilityWhenFalseConverter}}" />-->
                        <!--<iconPacks:PackIconMaterial Kind="Pin" Visibility="{Binding IsChecked, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=ToggleButton}, Converter={conv:VisibilityWhenTrueConverter}}" />-->
                        <!--</Grid>-->
                    </Viewbox>
                </ToggleButton.Content>
            </ToggleButton>

            <!--<ToggleButton
                Padding="6"
                Background="Transparent"
                BorderThickness="0"
                Cursor="Hand"
                Foreground="{DynamicResource MahApps.Brushes.AccentBase}"
                IsChecked="{Binding IsTopMost, Source={x:Static serv:SettingsService.Instance}}"
                ToolTip="{lex:BLoc TopMost, TargetNullValue={}Stay On Top}">
                <ToggleButton.Effect>
                    <DropShadowEffect
                        BlurRadius="10"
                        Direction="250"
                        Opacity=".6"
                        ShadowDepth="3" />
                </ToggleButton.Effect>
                <ToggleButton.Content>
            -->
            <!--<iconPacks:PackIconFontAwesome Kind="ThumbtackSolid" />-->
            <!--
                    <Viewbox>
                        <Viewbox.Effect>
                            <DropShadowEffect
                                BlurRadius="3"
                                Direction="250"
                                Opacity=".6"
                                ShadowDepth="2" />
                        </Viewbox.Effect>
            -->
            <!--<iconPacks:PackIconMaterial Kind="Settings" />-->
            <!--
                        <Grid>
                            <iconPacks:PackIconMaterial Kind="PinOff" Visibility="{Binding IsChecked, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=ToggleButton}, Converter={conv:VisibilityWhenFalseConverter}}" />
                            <iconPacks:PackIconMaterial Kind="Pin" Visibility="{Binding IsChecked, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=ToggleButton}, Converter={conv:VisibilityWhenTrueConverter}}" />
                        </Grid>
                    </Viewbox>
                </ToggleButton.Content>
            </ToggleButton>-->
            <!--<Separator Style="{StaticResource WindowCommandsSeparator}" />-->
        </mm:WindowCommands>
    </mm:MetroWindow.RightWindowCommands>
    <!--<mm:MetroWindow.TitleTemplate>
        <ItemContainerTemplate>
            <ContentControl ContentTemplate="{StaticResource FormTitleBig}" />
        </ItemContainerTemplate>
    MouseDown="Window_MouseDown"
    </mm:MetroWindow.TitleTemplate>-->

    <Grid ap:WindowHelper.MoveWindowOnMouseDown="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=mm:MetroWindow}}" Background="{DynamicResource MahApps.Brushes.Window.Background}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <!--  Drop Shadow Line  -->
        <ContentPresenter Grid.Row="0" ContentTemplate="{StaticResource CenterShadowLine}" />

        <!--#region Test-->
        <!--<StackPanel Grid.Row="1">
            <TextBox
                MinWidth="200"
                HorizontalAlignment="Left"
                ap:TextBoxHelper.EditType="FileName" />
            <TextBox
                MinWidth="200"
                Margin="10"
                HorizontalAlignment="Left"
                ap:TextBoxHelper.EditType="FileName"
                Style="{StaticResource EzzFilterTextBoxDynamicIcon}" />
            <ComboBox
                MinWidth="200"
                Margin="10"
                HorizontalAlignment="Left"
                Style="{StaticResource EzzFilterComboBoxDynamicIcon}" />
            <ComboBox
                MinWidth="200"
                Margin="10"
                HorizontalAlignment="Left" />
        </StackPanel>-->
        <!--#endregion-->
        
        <controls:PageHost
            Grid.Row="2"
            CurrentPage="{Binding CurrentPage, Source={x:Static vm:ApplicationViewModel.Instance}}"
            CurrentPageViewModel="{Binding CurrentPageViewModel, Source={x:Static vm:ApplicationViewModel.Instance}}" />
    </Grid>
</mm:MetroWindow>