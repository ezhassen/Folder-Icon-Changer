<local:BasePage
    x:Class="FolderIconChangerWPF.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="clr-namespace:FolderIconChangerWPF.ValueConverters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:lex="http://wpflocalizeextension.codeplex.com"
    xmlns:local="clr-namespace:FolderIconChangerWPF.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:mm="http://metro.mahapps.com/winfx/xaml/controls"
    xmlns:serv="clr-namespace:FolderIconChangerWPF.Services"
    d:DesignHeight="450"
    d:DesignWidth="800"
    lex:LocalizeDictionary.DesignCulture="en"
    lex:LocalizeDictionary.OutputMissingKeys="True"
    lex:ResxLocalizationProvider.DefaultAssembly="Folder Icon Changer"
    lex:ResxLocalizationProvider.DefaultDictionary="Resources"
    DataContext="{Binding Source={x:Static serv:SettingsService.Instance}}"
    PageLoadAnimationFrom="Bottom"
    PageUnloadAnimationTo="Top"
    mc:Ignorable="d">

    <local:BasePage.Resources>
        <Style BasedOn="{StaticResource MahApps.Styles.ToggleSwitch.Win10}" TargetType="mm:ToggleSwitch">
            <Setter Property="ContentTemplate">
                <Setter.Value>
                    <ItemContainerTemplate>
                        <!--<Border
                                                        Padding="3"
                                                        BorderBrush="{DynamicResource MahApps.Brushes.Gray6}"
                                                        BorderThickness="0"
                                                        CornerRadius="5">-->
                        <TextBlock Text="{Binding}" TextWrapping="Wrap" />
                        <!--</Border>-->
                    </ItemContainerTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>
    </local:BasePage.Resources>

    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock
            Margin="0,40,0,20"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Style="{StaticResource TextBlockTitle}"
            Text="{lex:BLoc Settings, TargetNullValue=Settings}" />
        <!--  ShowCurrentFolderForIconFromImage  -->
        <StackPanel Grid.Row="1" HorizontalAlignment="Center">

            <mm:ToggleSwitch
                Margin="0,10"
                Content="{lex:BLoc ShowCurrentFolderForIconFromImage}"
                IsChecked="{Binding ShowCurrentFolderForIconFromImage}" />

            <StackPanel Margin="0,10" HorizontalAlignment="Center">
                <Button
                    Margin="0,10"
                    Command="{Binding ClearRecentFoldersCommand}"
                    Content="{lex:BLoc bClearRecentFolders, TargetNullValue=Clear Recent Folders}"
                    IsEnabled="{Binding AllowClearRecentFolders}" />
                <Button
                    Margin="0,10"
                    Command="{Binding ClearRecentFilesCommand}"
                    Content="{lex:BLoc bClearRecentFiles, TargetNullValue=Clear Recent Files}"
                    IsEnabled="{Binding AllowClearRecentFiles}" />
            </StackPanel>
        </StackPanel>
    </Grid>
</local:BasePage>
