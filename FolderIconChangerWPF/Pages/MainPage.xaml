<local:BasePage
    x:Class="FolderIconChangerWPF.Pages.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ap="clr-namespace:FolderIconChangerWPF.AttachedProperties"
    xmlns:controls="clr-namespace:FolderIconChangerWPF.Controls"
    xmlns:conv="clr-namespace:FolderIconChangerWPF.ValueConverters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
    xmlns:lex="http://wpflocalizeextension.codeplex.com"
    xmlns:local="clr-namespace:FolderIconChangerWPF.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:mm="http://metro.mahapps.com/winfx/xaml/controls"
    xmlns:serv="clr-namespace:FolderIconChangerWPF.Services"
    xmlns:sys="clr-namespace:System;assembly=mscorlib"
    xmlns:sysCollections="clr-namespace:System.Collections;assembly=mscorlib"
    xmlns:vm="clr-namespace:FolderIconChangerWPF.ViewModels"
    Width="520"
    MinWidth="520"
    MinHeight="480"
    d:DesignHeight="450"
    d:DesignWidth="800"
    lex:LocalizeDictionary.DesignCulture="en"
    lex:LocalizeDictionary.OutputMissingKeys="True"
    lex:ResxLocalizationProvider.DefaultAssembly="Folder Icon Changer"
    lex:ResxLocalizationProvider.DefaultDictionary="Resources"
    DataContext="{Binding Source={x:Static vm:MainPageViewModel.Instance}}"
    FadeInAndOutOnly="False"
    PageLoadAnimationFrom="Top"
    PageUnloadAnimationTo="Top"
    mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.Resources>
            <DropShadowEffect
                x:Key="ButtonShadowEffect"
                BlurRadius="15"
                Direction="270"
                ShadowDepth="3" />
            <DropShadowEffect
                x:Key="IconShadowEffect"
                BlurRadius="5"
                ShadowDepth="1" />

            <Style TargetType="controls:IconImageControl">
                <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
                <Setter Property="BorderThickness" Value="2" />
                <Setter Property="Effect">
                    <Setter.Value>
                        <DropShadowEffect BlurRadius="15" Direction="270" />
                    </Setter.Value>
                </Setter>
                <Setter Property="Height" Value="{Binding Width, RelativeSource={RelativeSource Self}}" />
                <Setter Property="HorizontalAlignment" Value="Left" />
                <Setter Property="Margin" Value="10" />
                <Setter Property="Width" Value="128" />
            </Style>

            <Style
                x:Key="BrowseButtonStyle"
                BasedOn="{StaticResource MetroButton}"
                TargetType="Button">
                <!--<Setter Property="Foreground" Value="{DynamicResource AccentBaseColorBrush}"/>-->
                <Setter Property="Content">
                    <Setter.Value>
                        <iconPacks:PackIconOcticons Kind="FileDirectory" />
                        <!--<iconPacks:PackIconMaterial Kind="FolderEdit" />-->
                    </Setter.Value>
                </Setter>
                <Setter Property="FontSize" Value="{StaticResource FontSizeRegular}" />
                <Setter Property="Margin" Value="5" />
                <Setter Property="MinWidth" Value="50" />
            </Style>


            <Style
                x:Key="MainCommandButtonStyle"
                BasedOn="{StaticResource MetroButton}"
                TargetType="Button">

                <Setter Property="Effect" Value="{StaticResource ButtonShadowEffect}" />
                <Setter Property="MinWidth" Value="120" />
                <Setter Property="MinWidth" Value="120" />
                <!--<Setter Property="Margin" Value="0,0,10,10" />-->
                <Setter Property="RenderTransform">
                    <Setter.Value>
                        <ScaleTransform />
                    </Setter.Value>
                </Setter>
                <Setter Property="RenderTransformOrigin">
                    <Setter.Value>
                        <Point X="0.5" Y="0.5" />
                    </Setter.Value>
                </Setter>

                <Style.Triggers>
                    <!--<EventTrigger RoutedEvent="Click">
                        <BeginStoryboard>
                            <Storyboard>
                    -->
                    <!--  Storyboard.TargetName="ApplyButton"  -->
                    <!--
                                <DoubleAnimation
                                    AutoReverse="True"
                                    Storyboard.TargetProperty="(RenderTransform).(ScaleTransform.ScaleX)"
                                    To="1.2"
                                    Duration="0:0:0.08" />
                    -->
                    <!--  Storyboard.TargetName="ApplyButton"  -->
                    <!--
                                <DoubleAnimation
                                    AutoReverse="True"
                                    Storyboard.TargetProperty="(RenderTransform).(ScaleTransform.ScaleY)"
                                    To="1.2"
                                    Duration="0:0:0.08" />
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>-->
                    <EventTrigger RoutedEvent="MouseEnter">
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation
                                    Storyboard.TargetProperty="(RenderTransform).(ScaleTransform.ScaleX)"
                                    To="1.1"
                                    Duration="0:0:0.15" />
                                <DoubleAnimation
                                    Storyboard.TargetProperty="(RenderTransform).(ScaleTransform.ScaleY)"
                                    To="1.1"
                                    Duration="0:0:0.15" />
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                    <EventTrigger RoutedEvent="MouseLeave">
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation
                                    Storyboard.TargetProperty="(RenderTransform).(ScaleTransform.ScaleX)"
                                    To="1"
                                    Duration="0:0:0.15" />
                                <DoubleAnimation
                                    Storyboard.TargetProperty="(RenderTransform).(ScaleTransform.ScaleY)"
                                    To="1"
                                    Duration="0:0:0.15" />
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>

                    <!--<Trigger Property="IsPressed" Value="True">
                    -->
                    <!--<Setter TargetName="border" Property="BorderBrush" Value="Transparent" />-->
                    <!--
                        <Setter Property="Background" Value="{DynamicResource WordOrangeBrush}">
                    -->
                    <!--<Setter.Value>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientBrush.GradientStops>
                                        <GradientStopCollection>
                                            <GradientStop Offset="0.0" Color="{DynamicResource Gray1}" />
                                            <GradientStop Offset="0.1" Color="{DynamicResource Gray2}" />
                                            <GradientStop Offset="0.9" Color="{DynamicResource Gray3}" />
                                            <GradientStop Offset="1.0" Color="{DynamicResource Gray4}" />
                                        </GradientStopCollection>
                                    </GradientBrush.GradientStops>
                                </LinearGradientBrush>
                            </Setter.Value>-->
                    <!--
                        </Setter>
                    -->
                    <!--<Setter Property="BorderBrush">
                            <Setter.Value>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientBrush.GradientStops>
                                        <GradientStopCollection>
                                            <GradientStop Offset="0.0" Color="{DynamicResource Gray1}" />
                                            <GradientStop Offset="1.0" Color="{DynamicResource Gray3}" />
                                        </GradientStopCollection>
                                    </GradientBrush.GradientStops>
                                </LinearGradientBrush>
                            </Setter.Value>
                        </Setter>-->
                    <!--  https://docs.microsoft.com/en-us/previous-versions/dotnet/netframework-3.0/ms753328(v=vs.85)  -->
                    <!--<Setter TargetName="border" Property="Background" Value="{StaticResource PressedBrush}" />
                            <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource PressedBorderBrush}" />-->
                    <!--
                    </Trigger>-->
                </Style.Triggers>

            </Style>

            <Style
                x:Key="RedMainCommandButtonStyle"
                BasedOn="{StaticResource MainCommandButtonStyle}"
                TargetType="Button">
                <Setter Property="Background" Value="{DynamicResource WordRedBrush}" />
                <Setter Property="Foreground" Value="White" />

            </Style>
        </Grid.Resources>
        <StackPanel Grid.Row="0" Margin="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <!--<ColumnDefinition Width="Auto" />-->
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <ComboBox
                    x:Name="TBTargetFolder"
                    Grid.Column="0"
                    Margin="5"
                    HorizontalAlignment="Stretch"
                    ap:TextBoxHelper.ClearFilterCommand="{Binding ClearTargetFolderCommand}"
                    ap:TextBoxHelper.FilterByEnterKey="True"
                    ap:TextBoxHelper.FilterCommand="{Binding RefreshCurrentInfoCommand}"
                    ap:TextBoxHelper.IsFiltering="{Binding IsLoadingCurrentInfo}"
                    ap:TextBoxHelper.RequireFilterAction="{Binding CurrentRequireRefresh}"
                    ap:TextBoxHelper.RequireFilterButtonToolTip="{lex:BLoc GetFolderIcon, TargetNullValue=Get Folder Icon}"
                    mm:TextBoxHelper.UseFloatingWatermark="True"
                    mm:TextBoxHelper.Watermark="{lex:BLoc TargetFolder, TargetNullValue=Target Folder}"
                    IsReadOnly="{Binding IsWorking}"
                    Style="{StaticResource PathComboBox}"
                    Text="{Binding TargetFolder, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                    ItemsSource="{Binding RecentFolders, Source={x:Static serv:SettingsService.Instance}}"/>

                <!--<Button
                    Grid.Column="1"
                    Command="{Binding BrowseForTargetFolderCommand}"
                    Style="{StaticResource BrowseButtonStyle}" />-->
                <controls:EzzSplitButton
                    Grid.Column="1"
                    MinWidth="60"
                    Margin="5"
                    ButtonCommand="{Binding BrowseForTargetFolderCommand}"
                    ToolTip="{lex:BLoc SelectTargetFolder}">
                    <controls:EzzSplitButton.ButtonContent>
                        <Viewbox>
                            <iconPacks:PackIconOcticons Kind="FileDirectory" />
                            <!--<iconPacks:PackIconMaterial Kind="FolderEdit" />-->
                        </Viewbox>
                    </controls:EzzSplitButton.ButtonContent>
                    <controls:EzzSplitButton.ArrowContextMenu>
                        <ContextMenu FlowDirection="{lex:BLoc FlowDirection, TargetNullValue=LeftToRight}" HorizontalOffset="-70">
                            <MenuItem
                                Command="{Binding CurrentOpenTargetFolderCommand}"
                                Header="{lex:BLoc OpenFolderInExplorer, TargetNullValue=Open Folder In Explorer}"
                                IsEnabled="{Binding TargetFolder, Converter={conv:BoolWhenStringConverter}}"
                                ToolTip="{Binding Header, RelativeSource={RelativeSource Self}}">
                                <MenuItem.Icon>
                                    <iconPacks:PackIconFontAwesome Margin="3" Kind="FileImageSolid" />
                                </MenuItem.Icon>
                            </MenuItem>
                        </ContextMenu>
                    </controls:EzzSplitButton.ArrowContextMenu>
                </controls:EzzSplitButton>
            </Grid>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <controls:IconImageControl
                    Grid.Column="0"
                    AllowToGenerateBestFit="{Binding CurrentIconPath, Converter={conv:BoolWhenStringConverter Value=False, Otherwise=True}}"
                    GenerateBestFitCommand="{Binding CurrentGenBestFitCommand}"
                    IconInfo="{Binding CurrentIconInfo}"
                    IsLoading="{Binding IsLoadingCurrentInfo}" />

                <StackPanel Grid.Column="1" Margin="0,0,65,0">
                    <!--<Grid Margin="5,20,5,5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>-->

                    <mm:Badged
                        MinWidth="20"
                        Margin="5,20,5,5"
                        Badge="{Binding CurrentIconIndex}"
                        ToolTip="{lex:BLoc Select_Icon_Index, TargetNullValue=Index}">
                        <TextBox
                            mm:TextBoxHelper.ButtonCommand="{Binding CurrentIconOpenContainingFolderCommand}"
                            mm:TextBoxHelper.TextButton="{Binding CurrentIconPath, Converter={conv:BoolWhenStringConverter}}"
                            IsReadOnly="True"
                            Style="{DynamicResource MetroButtonTextBox}"
                            Text="{Binding CurrentIconPath}"
                            ToolTip="{lex:BLoc FilePath, TargetNullValue=File Path}">
                            <mm:TextBoxHelper.ButtonContentTemplate>
                                <ItemContainerTemplate>
                                    <iconPacks:PackIconMaterial Kind="FolderOpen" ToolTip="{lex:BLoc OpenContainingFolder, TargetNullValue=Open Containing Folder}" />
                                </ItemContainerTemplate>
                            </mm:TextBoxHelper.ButtonContentTemplate>
                        </TextBox>
                    </mm:Badged>
                    <!--<TextBox
                            Grid.Column="1"
                            MinWidth="40"
                            Margin="5"
                            IsReadOnly="True"
                            Text="{Binding CurrentIconIndex}"
                            TextAlignment="Center" />-->
                    <!--</Grid>-->


                </StackPanel>
                <Button
                    x:Name="ResetButton"
                    Grid.Column="1"
                    Margin="10,10,10,10"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Background="{DynamicResource WordRedBrush}"
                    Command="{Binding ResetTargetFolderIconCommand}"
                    Foreground="White"
                    IsEnabled="{Binding CurrentIconPath, Converter={conv:BoolWhenStringConverter}}"
                    Style="{StaticResource MainCommandButtonStyle}"
                    ToolTip="{lex:BLoc ResetToDefaultIcon}">
                    <Button.Triggers>
                        <EventTrigger RoutedEvent="MouseDown" />
                    </Button.Triggers>
                    <Grid Focusable="False">
                        <Grid.RowDefinitions>
                            <RowDefinition />
                            <RowDefinition />
                        </Grid.RowDefinitions>
                        <iconPacks:PackIconOcticons
                            Grid.Row="0"
                            Margin="0,5,0,0"
                            Padding="-5"
                            HorizontalAlignment="Center"
                            Effect="{StaticResource IconShadowEffect}"
                            Focusable="False"
                            Kind="Trashcan" />
                        <TextBlock
                            Grid.Row="1"
                            Margin="0,3"
                            HorizontalAlignment="Center"
                            Effect="{StaticResource IconShadowEffect}"
                            Focusable="False"
                            FontSize="{StaticResource FontSizeLarge}"
                            Text="{lex:BLoc Reset, TargetNullValue=Reset}" />
                    </Grid>
                </Button>
            </Grid>
        </StackPanel>
        <!--  Bottom Contents  -->
        <GroupBox Grid.Row="1" Header="{lex:BLoc NewIconInfo, TargetNullValue={}New Icon Info}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <!--  New Icon Path and Index ctrls  -->
                <Grid Grid.Row="0" Margin="5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ComboBox
                        Grid.Row="0"
                        ap:TextBoxHelper.ClearFilterCommand="{Binding ClearNewIconPathCommand}"
                        ap:TextBoxHelper.EditType="Path"
                        ap:TextBoxHelper.FilterByEnterKey="True"
                        ap:TextBoxHelper.FilterCommand="{Binding RefreshNewInfoCommand}"
                        ap:TextBoxHelper.IsFiltering="{Binding IsLoadingNewInfo}"
                        ap:TextBoxHelper.RequireFilterAction="{Binding NewRequireRefresh}"
                        ap:TextBoxHelper.RequireFilterButtonToolTip="{lex:BLoc GetIcon, TargetNullValue=Get Icon}"
                        mm:TextBoxHelper.UseFloatingWatermark="True"
                        mm:TextBoxHelper.Watermark="{lex:BLoc FilePath, TargetNullValue=File Path}"
                        IsReadOnly="{Binding IsWorking}"
                        Style="{StaticResource PathComboBox2}"
                        ItemsSource="{Binding RecentFilesWithDefaults, Source={x:Static serv:SettingsService.Instance}}"
                        Text="{Binding NewIconPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" >

                        <!--ItemsSource="{Binding RecentFilesWithDefaults, Source={x:Static serv:SettingsService.Instance}}"-->
                        <!--<ComboBox.ItemsSource>
                            <MultiBinding>
                                <Binding Source="{x:Static serv:SettingsService.Instance}" Path="RecentFiles"/>
                                <Binding Source="{x:Static serv:SettingsService.Instance}" Path="DefaultRecentFiles"/>
                            </MultiBinding>
                        </ComboBox.ItemsSource>-->
                        
                    </ComboBox>

                    <mm:NumericUpDown
                        Grid.Column="1"
                        MinWidth="70"
                        Margin="5,0"
                        IsReadOnly="{Binding IsWorking}"
                        Maximum="{Binding NewIconMaxIndex}"
                        Minimum="0"
                        NumericInputMode="Numbers"
                        SelectAllOnFocus="True"
                        ToolTip="{lex:BLoc Select_Icon_Index, TargetNullValue=Index}"
                        Value="{Binding NewIconIndex, TargetNullValue=0}" />

                    <controls:EzzSplitButton
                        Grid.Column="3"
                        Margin="5,0"
                        ButtonCommand="{Binding BrowseForIconCommand}"
                        ButtonToolTip="{lex:BLoc BrowseForAnIconFile}">
                        <controls:EzzSplitButton.ButtonContent>
                            <Viewbox>
                                <iconPacks:PackIconFontAwesome Kind="FileSolid" />
                            </Viewbox>
                        </controls:EzzSplitButton.ButtonContent>
                        <controls:EzzSplitButton.ArrowContextMenu>
                            <ContextMenu FlowDirection="{lex:BLoc FlowDirection, TargetNullValue=LeftToRight}" HorizontalOffset="-70">
                                <MenuItem
                                    Command="{Binding IconFromImageCommand}"
                                    Header="{lex:BLoc IconFromImage, TargetNullValue=Icon From Image}"
                                    ToolTip="{lex:BLoc GenerateNewIconFromAnImage, TargetNullValue=Generate new Icon from an image}">
                                    <MenuItem.Icon>
                                        <iconPacks:PackIconFontAwesome Margin="3" Kind="FileImageSolid" />
                                    </MenuItem.Icon>
                                </MenuItem>
                            </ContextMenu>
                        </controls:EzzSplitButton.ArrowContextMenu>
                    </controls:EzzSplitButton>
                    <!--<mm:SplitButton
                        Grid.Column="2"
                        MinWidth="50"
                        Margin="5,0,0,0">
                        <mm:SplitButton.Icon>
                            <iconPacks:PackIconFontAwesome Kind="FileSolid" />
                        </mm:SplitButton.Icon>
                        <mm:SplitButton.ItemsSource>
                            <mm:HamburgerMenuItemCollection>
                                <mm:HamburgerMenuIconItem Label="Icon From Image" ToolTip="Generate new Icon from an image" Command="{Binding IconFromImageCommand}">
                                    <mm:HamburgerMenuIconItem.Icon>
                                        <iconPacks:PackIconFontAwesome Kind="FileImageSolid" />
                                    </mm:HamburgerMenuIconItem.Icon>
                                </mm:HamburgerMenuIconItem>
                            </mm:HamburgerMenuItemCollection>
                        </mm:SplitButton.ItemsSource>
                    </mm:SplitButton>-->
                </Grid>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>

                    <controls:IconImageControl
                        Grid.Column="0"
                        VerticalAlignment="Top"
                        IconInfo="{Binding NewIconInfo}"
                        IsLoading="{Binding IsLoadingNewInfo}" />

                    <Grid Grid.Column="1" Margin="5">
                        <Grid.RowDefinitions>
                            <RowDefinition />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <!--  New Icon Options  -->
                        <!--<GroupBox Header="Options">-->

                        <StackPanel Margin="10,0">
                            <StackPanel.Resources>
                                <Style BasedOn="{StaticResource MahApps.Metro.Styles.ToggleSwitch.Win10}" TargetType="mm:ToggleSwitch">
                                    <Setter Property="ContentTemplate">
                                        <Setter.Value>
                                            <ItemContainerTemplate>
                                                <!--<Border
                                                        Padding="3"
                                                        BorderBrush="{DynamicResource GrayBrush6}"
                                                        BorderThickness="0"
                                                        CornerRadius="5">-->
                                                <TextBlock Text="{Binding}" TextWrapping="Wrap" />
                                                <!--</Border>-->
                                            </ItemContainerTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                </Style>
                            </StackPanel.Resources>
                            <mm:ToggleSwitch
                                Margin="0,5"
                                ContentDirection="RightToLeft"
                                IsChecked="{Binding Source={x:Static serv:SettingsService.Instance}, Path=CopyIconToFolder}"
                                OffLabel="{lex:BLoc CopyIconToFolderOff, TargetNullValue={}New Icon wont be copied to the target folder}"
                                OnLabel="{lex:BLoc CopyIconToFolderOn, TargetNullValue={}New Icon will be copied to the target folder}"
                                OnSwitchBrush="{DynamicResource WordGreenBrush}"
                                ToolTip="{lex:BLoc CopyIconToFolder, TargetNullValue={}Copy new icon to the target folder}" />

                            <mm:ToggleSwitch
                                Height="Auto"
                                Margin="0,5"
                                VerticalAlignment="Stretch"
                                ContentDirection="RightToLeft"
                                IsChecked="{Binding Source={x:Static serv:SettingsService.Instance}, Path=HideIcon}"
                                OffLabel="{lex:BLoc HideIconOff, TargetNullValue={}New Icon file wont be hidden If it exists in the target folder}"
                                OnLabel="{lex:BLoc HideIconOn, TargetNullValue={}New Icon file will be hidden}"
                                OnSwitchBrush="{DynamicResource WordRedBrush}"
                                ToolTip="{lex:BLoc HideIcon, TargetNullValue={}Hide the Icon file if it exists in the target folder}" />

                        </StackPanel>
                        <!--</GroupBox>-->

                        <!--  New Icon Apply Command  -->
                        <!--  IsEnabled="{Binding NewIconInfo, Converter={conv:BoolWhenNullConverter}}"  -->
                        <Button
                            x:Name="ApplyButton"
                            Grid.Row="1"
                            Margin="0,10,10,10"
                            HorizontalAlignment="Right"
                            Command="{Binding ApplyNewIconCommand}"
                            Style="{StaticResource MainCommandButtonStyle}">
                            <Button.IsEnabled>
                                <MultiBinding Converter="{conv:BoolWhenBoolConverter MultiWhenAny=False}">

                                    <Binding Converter="{conv:BoolWhenFolderExistsConverter}" Path="TargetFolder" />
                                    <Binding Converter="{conv:BoolWhenNullConverter}" Path="NewIconInfo" />
                                    <!--<Binding Path="GenerateBestFitCommand"/>-->
                                </MultiBinding>
                            </Button.IsEnabled>

                            <Grid Focusable="False">
                                <Grid.RowDefinitions>
                                    <RowDefinition />
                                    <RowDefinition />
                                </Grid.RowDefinitions>
                                <iconPacks:PackIconFontAwesome
                                    Grid.Row="0"
                                    Margin="0,3,0,0"
                                    Padding="-5"
                                    HorizontalAlignment="Center"
                                    Effect="{StaticResource IconShadowEffect}"
                                    Focusable="False"
                                    Kind="CheckSolid" />
                                <TextBlock
                                    Grid.Row="1"
                                    Margin="0,3"
                                    HorizontalAlignment="Center"
                                    Effect="{StaticResource IconShadowEffect}"
                                    Focusable="False"
                                    FontSize="{StaticResource FontSizeLarge}"
                                    Text="{lex:BLoc Apply, TargetNullValue=Apply}" />
                            </Grid>
                        </Button>
                    </Grid>
                </Grid>
            </Grid>
        </GroupBox>
    </Grid>
</local:BasePage>
