<local:BasePage
    x:Class="FolderIconChangerWPF.Pages.AboutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="clr-namespace:FolderIconChangerWPF.ValueConverters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:lex="http://wpflocalizeextension.codeplex.com"
    xmlns:local="clr-namespace:FolderIconChangerWPF.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:mm="http://metro.mahapps.com/winfx/xaml/controls"
    xmlns:serv="clr-namespace:FolderIconChangerWPF.Services"
    xmlns:vm="clr-namespace:FolderIconChangerWPF.ViewModels"
    d:DesignHeight="431"
    d:DesignWidth="800"
    lex:LocalizeDictionary.DesignCulture="en"
    lex:LocalizeDictionary.OutputMissingKeys="True"
    lex:ResxLocalizationProvider.DefaultAssembly="Folder Icon Changer"
    lex:ResxLocalizationProvider.DefaultDictionary="Resources"
    PageLoadAnimationFrom="Bottom"
    PageUnloadAnimationTo="Top"
    mc:Ignorable="d">
    <local:BasePage.DataContext>
        <vm:AboutPageViewModel />
    </local:BasePage.DataContext>

    <local:BasePage.Resources>
        <Style
            x:Key="InfoText"
            BasedOn="{StaticResource MetroTextBox}"
            TargetType="TextBox">
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="IsReadOnlyCaretVisible" Value="True" />
            <Setter Property="Margin" Value="12" />
            <Setter Property="mm:TextBoxHelper.UseFloatingWatermark" Value="True" />

        </Style>

    </local:BasePage.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Style="{StaticResource TextBlockTitle}"
            Text="{lex:BLoc About, TargetNullValue=About}" />

        <Grid Grid.Row="1" Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!--  Image  -->
            <Grid Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Border
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    BorderBrush="{DynamicResource ControlBorderBrush}"
                    BorderThickness="2">
                    <Border.Effect>
                        <DropShadowEffect
                            BlurRadius="15"
                            Direction="270"
                            ShadowDepth="5" />
                    </Border.Effect>
                    <Image MinHeight="50" Source="pack://application:,,,/Images/Ezz14_Left.jpg">
                        <Image.Effect>
                            <DropShadowEffect
                                BlurRadius="30"
                                Direction="270"
                                ShadowDepth="5" />
                        </Image.Effect>
                    </Image>
                </Border>

                <!--  email / Website  -->
                <Viewbox
                    Grid.Row="1"
                    Margin="10,5,10,0"
                    HorizontalAlignment="Center">
                    <Viewbox.Effect>
                        <DropShadowEffect
                            BlurRadius="30"
                            Direction="270"
                            ShadowDepth="5" />
                    </Viewbox.Effect>
                    <Button
                        Padding="5,0" Margin="5,1"
                        HorizontalAlignment="Center"
                        Content="ezhassen@outlook.com"
                        Foreground="{DynamicResource AccentBaseColorBrush}"
                        Style="{StaticResource LinkButton}" />
                    <!--<TextBlock Padding="5,0" FontWeight="Bold">
                        <Hyperlink Foreground="{DynamicResource AccentBaseColorBrush}" NavigateUri="ezhassen@outlook.com">
                            <Run Text="ezhassen@outlook.com" />
                        </Hyperlink>
                    </TextBlock>-->
                </Viewbox>
                <Viewbox
                    Grid.Row="2"
                    Margin="10,5,0,0"
                    HorizontalAlignment="Center">
                    <Viewbox.Effect>
                        <DropShadowEffect
                            BlurRadius="30"
                            Direction="270"
                            ShadowDepth="5" />
                    </Viewbox.Effect>
                    <Button
                        Padding="5,0" Margin="5,1"
                        HorizontalAlignment="Center"
                        Command="{Binding OpenLinkCommand}"
                        CommandParameter="https://fb.com/ezhassen"
                        Content="https://fb.com/ezhassen"
                        Foreground="{DynamicResource AccentBaseColorBrush}"
                        Style="{StaticResource LinkButton}" />
                    <!--<TextBlock Padding="5,0" FontWeight="Bold">
                        <Hyperlink Foreground="{DynamicResource AccentBaseColorBrush}" NavigateUri="https://fb.com/ezhassen">
                            <Run Text="https://fb.com/ezhassen" />
                        </Hyperlink>
                    </TextBlock>-->
                </Viewbox>


            </Grid>


            <!--  App Info  -->
            <Grid
                Grid.Column="1"
                Margin="5"
                FlowDirection="{lex:BLoc FlowDirection}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!--  Name  -->
                <TextBox
                    Grid.Row="0"
                    mm:TextBoxHelper.Watermark="{lex:BLoc tAppName, TargetNullValue=App Name}"
                    Style="{StaticResource InfoText}"
                    Text="{lex:BLoc MainFormTitle, TargetNullValue=Folder Icon Changer}" />

                <!--  Version  -->
                <TextBox
                    Grid.Row="1"
                    mm:TextBoxHelper.Watermark="{lex:BLoc Version, TargetNullValue=Version}"
                    Style="{StaticResource InfoText}"
                    Text="{Binding AssemblyVersion, FallbackValue=0.0.0.0, Mode=OneWay}" />

                <!--  CopyRight  -->
                <TextBox
                    Grid.Row="2"
                    mm:TextBoxHelper.Watermark="{lex:BLoc tCopyright, TargetNullValue=Copyright}"
                    Style="{StaticResource InfoText}"
                    Text="{Binding AssemblyCopyright, FallbackValue=Copyright, Mode=OneWay}" />
                <!--  Dev Name  -->
                <TextBox
                    Grid.Row="3"
                    mm:TextBoxHelper.Watermark="{lex:BLoc tDevName, TargetNullValue=Dev Name}"
                    Style="{StaticResource InfoText}"
                    Text="{Binding DevName, FallbackValue=Ezz Hasan, Mode=OneWay}" />

                <!--  Description  -->
                <TextBox
                    Grid.Row="4"
                    MaxHeight="200"
                    HorizontalContentAlignment="Stretch"
                    mm:TextBoxHelper.Watermark="{lex:BLoc tDescription, TargetNullValue=Description}"
                    Style="{StaticResource InfoText}"
                    Text="{lex:BLoc AppDescription, TargetNullValue=...}"
                    TextWrapping="Wrap" />
            </Grid>

        </Grid>

    </Grid>
</local:BasePage>
