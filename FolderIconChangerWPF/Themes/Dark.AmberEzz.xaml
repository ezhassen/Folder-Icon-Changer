<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:options="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
    xmlns:system="clr-namespace:System;assembly=mscorlib"
    mc:Ignorable="options">

    <ResourceDictionary.MergedDictionaries>
        <!--  Base mahapps theme  -->
        <ResourceDictionary Source="pack://application:,,,/MahApps.Metro;component/Styles/Themes/Dark.Amber.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!--  Matadata  -->
    <system:String x:Key="Theme.Name">Dark.AmberEzz</system:String>
    <system:String x:Key="Theme.DisplayName">Amber (BlueDark)</system:String>
    <system:String x:Key="Theme.BaseColorScheme">Dark</system:String>
    <system:String x:Key="Theme.ColorScheme">Amber</system:String>
    <SolidColorBrush
        x:Key="Theme.ShowcaseBrush"
        options:Freeze="True"
        Color="#FFF0A30A" />

    <!--  mahapp Theme  -->

    <Color x:Key="MahApps.Colors.ThemeBackground">#FF025A9D</Color>
    <Color x:Key="MahApps.Colors.ThemeForeground">#FFFFFFFF</Color>

    <Color x:Key="MahApps.Colors.Gray8">#FF0464AE</Color>
    <Color x:Key="MahApps.Colors.Gray10">#FF004D88</Color>
    <Color x:Key="MahApps.Colors.Flyout">#FF0F69AE</Color>
    <Color x:Key="BackgroundLight">#efefef</Color>
    <Color x:Key="BackgroundVeryLight">#fafafa</Color>
    <Color x:Key="ForegroundMain">#686868</Color>
    <Color x:Key="ForegroundVeryDark">#000000</Color>
    <Color x:Key="ForegroundLight">#ffffff</Color>
    <Color x:Key="ForegroundDark">#bdbdbd</Color>

    <SolidColorBrush
        x:Key="MahApps.Brushes.Control.Background"
        options:Freeze="True"
        Color="{StaticResource MahApps.Colors.ThemeBackground}" />
    <SolidColorBrush
        x:Key="MahApps.Brushes.ThemeBackground"
        options:Freeze="True"
        Color="{StaticResource MahApps.Colors.ThemeBackground}" />
    <SolidColorBrush
        x:Key="MahApps.Brushes.ThemeForeground"
        options:Freeze="True"
        Color="{StaticResource MahApps.Colors.ThemeForeground}" />
    <SolidColorBrush
        x:Key="MahApps.Brushes.Text"
        options:Freeze="True"
        Color="{StaticResource MahApps.Colors.ThemeForeground}" />
    <SolidColorBrush
        x:Key="MahApps.Brushes.Label.Text"
        options:Freeze="True"
        Color="{StaticResource MahApps.Colors.ThemeForeground}" />
    <SolidColorBrush
        x:Key="MahApps.Brushes.ThemeBackgroundColor"
        options:Freeze="True"
        Color="{StaticResource MahApps.Colors.ThemeBackground}" />
    <SolidColorBrush
        x:Key="MahApps.Brushes.ThemeForegroundColor"
        options:Freeze="True"
        Color="{StaticResource MahApps.Colors.ThemeForeground}" />

    <SolidColorBrush
        x:Key="MahApps.Brushes.DisabledWhite"
        options:Freeze="True"
        Color="{StaticResource MahApps.Colors.ThemeBackground}" />

    <LinearGradientBrush x:Key="MahApps.Brushes.CheckBox.Background" options:Freeze="True" StartPoint="0.5,0" EndPoint="0.5,1">
        <GradientStop Offset="0" Color="{StaticResource MahApps.Colors.Gray7}" />
        <GradientStop Offset="1" Color="{StaticResource MahApps.Colors.ThemeBackground}" />
    </LinearGradientBrush>

    <SolidColorBrush
        x:Key="MahApps.Brushes.Window.Background"
        options:Freeze="True"
        Color="{StaticResource MahApps.Colors.ThemeBackground}" />
    <SolidColorBrush
        x:Key="{x:Static SystemColors.WindowBrushKey}"
        options:Freeze="True"
        Color="{StaticResource MahApps.Colors.ThemeBackground}" />

    <!--  menu default colors  -->
    <SolidColorBrush
        x:Key="MahApps.Brushes.Menu.Background"
        options:Freeze="True"
        Color="{StaticResource MahApps.Colors.ThemeBackground}" />
    <SolidColorBrush
        x:Key="MahApps.Brushes.ContextMenu.Background"
        options:Freeze="True"
        Color="{StaticResource MahApps.Colors.ThemeBackground}" />
    <SolidColorBrush
        x:Key="MahApps.Brushes.SubMenu.Background"
        options:Freeze="True"
        Color="{StaticResource MahApps.Colors.ThemeBackground}" />
    <SolidColorBrush
        x:Key="MahApps.Brushes.MenuItem.Background"
        options:Freeze="True"
        Color="{StaticResource MahApps.Colors.ThemeBackground}" />


    <SolidColorBrush
        x:Key="MahApps.Brushes.Gray8"
        options:Freeze="True"
        Color="{StaticResource MahApps.Colors.Gray8}" />

    <SolidColorBrush
        x:Key="MahApps.Brushes.Gray10"
        options:Freeze="True"
        Color="{StaticResource MahApps.Colors.Gray10}" />

    <SolidColorBrush
        x:Key="MahApps.Brushes.Flyout.Background"
        options:Freeze="True"
        Color="{StaticResource MahApps.Colors.Flyout}" />

    <SolidColorBrush
        x:Key="MahApps.Brushes.FlatButton.Foreground"
        options:Freeze="True"
        Color="#FF043B64" />
    <SolidColorBrush
        x:Key="MahApps.Brushes.FlatButton.PressedBackground"
        options:Freeze="True"
        Color="#FF0C73C1" />

    <SolidColorBrush
        x:Key="MahApps.Brushes.MenuItem.SelectionFill"
        options:Freeze="True"
        Color="{StaticResource MahApps.Colors.AccentBase}" />
    <SolidColorBrush
        x:Key="MahApps.Brushes.MenuItem.SelectionStroke"
        options:Freeze="True"
        Color="{StaticResource MahApps.Colors.AccentBase}" />

    <SolidColorBrush
        x:Key="MahApps.Brushes.TopMenuItem.PressedFill"
        options:Freeze="True"
        Color="{StaticResource MahApps.Colors.AccentBase}" />

    <!--  Custom Theme  -->

    <SolidColorBrush x:Key="BackgroundLightBrush" Color="{StaticResource BackgroundLight}" />

    <SolidColorBrush x:Key="BackgroundVeryLightBrush" Color="{StaticResource BackgroundVeryLight}" />

    <SolidColorBrush x:Key="ForegroundMainBrush" Color="{StaticResource ForegroundMain}" />

    <SolidColorBrush x:Key="ForegroundVeryDarkBrush" Color="{StaticResource ForegroundVeryDark}" />

    <SolidColorBrush x:Key="ForegroundLightBrush" Color="{StaticResource ForegroundLight}" />

    <SolidColorBrush x:Key="ForegroundDarkBrush" Color="{StaticResource ForegroundDark}" />

    <Color x:Key="EzzWordBlue">#3099c5</Color>
    <SolidColorBrush x:Key="EzzWordBlueBrush" Color="{StaticResource EzzWordBlue}" />

    <Color x:Key="EzzWordTransparentBlue">#003099c5</Color>
    <SolidColorBrush x:Key="EzzWordTransparentBlueBrush" Color="{StaticResource EzzWordTransparentBlue}" />

    <Color x:Key="EzzWordLightBlue">#45b6e5</Color>
    <SolidColorBrush x:Key="EzzWordLightBlueBrush" Color="{StaticResource EzzWordLightBlue}" />

    <Color x:Key="EzzWordVeryLightBlue">#c3e5f3</Color>
    <SolidColorBrush x:Key="EzzWordVeryLightBlueBrush" Color="{StaticResource EzzWordVeryLightBlue}" />

    <Color x:Key="EzzWordVeryVeryLightBlue">#ecf6fb</Color>
    <SolidColorBrush x:Key="EzzWordVeryVeryLightBlueBrush" Color="{StaticResource EzzWordVeryVeryLightBlue}" />

    <Color x:Key="EzzWordDarkBlue">#0c6991</Color>
    <SolidColorBrush x:Key="EzzWordDarkBlueBrush" Color="{StaticResource EzzWordDarkBlue}" />

    <Color x:Key="EzzWordOrange">#ffa800</Color>
    <SolidColorBrush x:Key="EzzWordOrangeBrush" Color="{StaticResource EzzWordOrange}" />

    <Color x:Key="EzzWordRed">#ff4747</Color>
    <SolidColorBrush x:Key="EzzWordRedBrush" Color="{StaticResource EzzWordRed}" />

    <Color x:Key="EzzWordGreen">#00c541</Color>
    <SolidColorBrush x:Key="EzzWordGreenBrush" Color="{StaticResource EzzWordGreen}" />

    <Color x:Key="EzzWindowActionsForeground">#EEEEEE</Color>
    <SolidColorBrush x:Key="EzzWindowActionsForegroundBrush" Color="{StaticResource EzzWindowActionsForeground}" />

    <Color x:Key="EzzWindowActions">Transparent</Color>
    <SolidColorBrush x:Key="EzzWindowActionsBrush" Color="{StaticResource EzzWindowActions}" />

    <Color x:Key="EzzWindowActionsHover">#D1B5B5B5</Color>
    <SolidColorBrush x:Key="EzzWindowActionsHoverBrush" Color="{StaticResource EzzWindowActionsHover}" />

    <Color x:Key="EzzWindowActionsPressed">#D15669A5</Color>
    <SolidColorBrush x:Key="EzzWindowActionsPressedBrush" Color="{StaticResource EzzWindowActionsPressed}" />

    <Color x:Key="EzzWindowCloseHover">#E81123</Color>
    <SolidColorBrush x:Key="EzzWindowCloseHoverBrush" Color="{StaticResource EzzWindowCloseHover}" />

    <Color x:Key="EzzWindowClosePressed">#F1707A</Color>
    <SolidColorBrush x:Key="EzzWindowClosePressedBrush" Color="{StaticResource EzzWindowClosePressed}" />

</ResourceDictionary>